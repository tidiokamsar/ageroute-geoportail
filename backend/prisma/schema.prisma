generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ===================== ENUMS =====================

enum Role {
  ADMIN
  GESTIONNAIRE
  INSPECTEUR
  LECTEUR
}

enum ClasseRoute {
  RN // Route Nationale
  RR // Route Régionale
  RU // Route Urbaine
  PISTE
  /// Ajoutee le 04/09/2026. Les quatre valeurs ci-dessus sont des DESIGNATIONS
  /// ADMINISTRATIVES ; une voie issue d'une source cartographique n'en porte aucune.
  /// Sans cette valeur, la promotion aurait du en inventer une — la faute exacte du
  /// BITUME. Voir 20260904100000_classe_non_classee.
  NON_CLASSEE
}

enum Revetement {
  BITUME
  TERRE
  LATERITE
  PAVE
  /// Ajoutee le 03/09/2026. Sans elle, une colonne obligatoire force a choisir un
  /// revetement qu'on ignore — c'est ainsi que les 1 690 troncons se sont retrouves
  /// a BITUME sans exception. Voir 20260903030000_revetement_non_renseigne.
  NON_RENSEIGNE
}

// ===================== QUALITE, PROVENANCE, CONFIANCE =====================
//
// Ces enums existent pour repondre a une question que la base ne savait pas poser :
// que sait-on REELLEMENT de cette valeur ? Un champ rempli n'est pas un champ
// renseigne. Mesure du 01/09/2026 : `revetement` vaut BITUME sur les 1 690 troncons
// sans une seule exception, et 29 intitules de chantiers decrivent des routes « en
// terre ». Les deux ne peuvent etre vrais. Sans statut, l'interface presentait une
// valeur d'import comme une caracteristique du reseau.

/// D'ou vient un enregistrement. La distinction qui compte est entre une provenance
/// DEDUITE (le prefixe du code trahit le lot d'import) et une provenance DOCUMENTEE
/// (quelqu'un a retrouve le document source). Les confondre ferait passer une
/// inference pour un fait etabli.
enum SourceType {
  IMPORT_CODE_PATTERN
  IMPORT_DOCUMENTE
  SAISIE_APPLICATIVE
  RECUPERATION_AUDIT
  INCONNUE
}

enum NiveauConfiance {
  HIGH
  MEDIUM
  LOW
}

/// Statut d'une valeur de champ. CONFLICTING n'est pas une erreur a corriger tout de
/// suite : c'est un signalement — deux sources internes se contredisent, quelqu'un
/// doit trancher avec une source externe.
enum StatutValeur {
  OBSERVED
  IMPORTED_UNVERIFIED
  DERIVED
  CONFLICTING
  UNKNOWN
}

/// Niveau de localisation reel d'un objet. NONE est une valeur legitime et doit le
/// rester : 50 chantiers sont rattaches a une region nommee « Non renseigne », et les
/// afficher au centre d'une region inventerait une position.
enum StatutLocalisation {
  NONE
  APPROXIMATIVE
  LINEAIRE
  PRECISE
}

enum StatutProposition {
  PROPOSED
  VALIDATED
  REJECTED
}

enum StatutRecuperation {
  PENDING_VALIDATION
  VALIDATED
  REJECTED
}

enum EtatPatrimoine {
  BON
  MOYEN
  MAUVAIS
  CRITIQUE
  NON_EVALUE
}

enum TypeOuvrage {
  PONT
  DALOT
  BUSE
  RADIER
  PONCEAU
  MUR_SOUTENEMENT
  TUNNEL
  PASSERELLE
  VIADUC
}

enum Gravite {
  FAIBLE
  MOYENNE
  FORTE
}

enum TypePoste {
  PEAGE
  PESAGE
}

enum StatutPoste {
  EN_SERVICE
  HORS_SERVICE
  EN_CONSTRUCTION
}

enum StatutChantier {
  PLANIFIE
  EN_COURS
  SUSPENDU
  TERMINE
}

enum DocumentType {
  ARRETE
  CAHIER_CHARGES
  CAHIER_ENGAGEMENT
  AUTRE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGIN_FAILED
  SECURITY_EVENT
}

enum DeviseMarche {
  GNF
  USD
  EUR
}

enum StatutMarche {
  PLANIFIE
  EN_COURS
  SUSPENDU
  TERMINE
  SOLDE
}

enum DecompteType {
  AVANCE
  DECOMPTE
  RETENUE_GARANTIE
  SOLDE
}

enum TypeInterventionOT {
  REPARATION_CHAUSSEE
  CURAGE_ASSAINISSEMENT
  SIGNALISATION
  DEBROUSSAILLAGE
  OUVRAGE_ART_MINEUR
  URGENCE_SECURITE
  AUTRE
}

enum PrioriteOT {
  URGENTE
  HAUTE
  NORMALE
  BASSE
}

enum StatutOT {
  BROUILLON
  ASSIGNE
  EN_COURS
  SUSPENDU
  TERMINE
  ANNULE
  CONVERTI_CHANTIER
}

enum TypePhotoOT {
  AVANT
  PENDANT
  APRES
}

enum CanalSignalement {
  PWA
  SMS_USSD
  AGENT
}

enum TypeProbleme {
  NID_DE_POULE
  CHAUSSEE_DEGRADEE
  OUVRAGE_ENDOMMAGE
  ROUTE_COUPEE
  INONDATION
  PANNEAU_SIGNALISATION
  VEGETATION
  DANGER_AUTRE
}

enum StatutSignalement {
  NOUVEAU
  EN_QUALIFICATION
  VALIDE
  REJETE
  DOUBLON
  CONVERTI_OT
  RESOLU
}

enum DecompteStatut {
  EMIS
  PAYE
  REJETE
}

// ===================== UTILISATEURS =====================

model User {
  id                    String                    @id @default(uuid())
  email                 String                    @unique
  nomComplet            String
  passwordHash          String
  role                  Role                      @default(LECTEUR)
  actif                 Boolean                   @default(true)
  derniereConnexion     DateTime?
  totpSecret            String?
  totpEnabled           Boolean                   @default(false)
  failedLoginAttempts   Int                       @default(0)
  lockedUntil           DateTime?
  // Tableau vide = pas de restriction (accès à tous les modules autorisés par le rôle,
  // comportement historique). Une fois renseigné, seuls les modules listés sont visibles
  // pour cet utilisateur, quel que soit son rôle — permet de retirer l'accès à un module
  // précis sans changer le rôle global.
  modulesAutorises      String[]                  @default([])
  refreshTokens         RefreshToken[]
  auditLogs             AuditLog[]
  inspections           Inspection[]
  otsAssignes           OrdreTravaux[]            @relation("OtAssigne")
  otsCrees              OrdreTravaux[]            @relation("OtCreateur")
  otPhotos              OtPhoto[]
  otHistoriques         OtHistorique[]
  signalementsQualifies SignalementCitoyen[]
  valeursConstatees     ValeurQualite[]
  propositionsDecidees  PropositionLocalisation[]

  // Terrain (AGEROUTE ROAD). Un agent possede des appareils, recoit et cree des
  // missions, enregistre des traces, produit des observations et en valide.
  appareils            Appareil[]
  missionsCreees       Mission[]       @relation("MissionCreateur")
  missionsAssignees    Mission[]       @relation("MissionAssigne")
  traces               Trace[]
  observations         Observation[]   @relation("ObservationAgent")
  observationsValidees Observation[]   @relation("ObservationValidateur")
  operationsSync       OperationSync[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@map("users")
}

// P3-A : le token brut ne vit QUE chez le client. En base : son empreinte
// SHA-256 (tokenHash, cle de recherche), sa famille de rotation (familyId,
// racine issuee au login), et l'historique de remplacement/reutilisation.
model RefreshToken {
  id              String    @id @default(uuid())
  tokenHash       String    @unique
  familyId        String
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedById    String?
  reuseDetectedAt DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ===================== REFERENTIELS =====================

/// Region administrative, avec sa validite dans le temps.
///
/// Les decrets du 20 aout 2026 portent la Guinee de 8 a 10 regions (creation de
/// Siguiri et Beyla). Une region n'est donc pas une constante : un chantier de 2019
/// et un chantier de 2026 ne se lisent pas dans le meme decoupage. `validFrom` et
/// `validTo` portent cette distinction, faute de quoi la base affirmerait que
/// l'organisation actuelle a toujours existe.
///
/// `code` vient du decret D/2025/055 du 14 avril 2025 et sert de cle d'appariement
/// stable : « Nzerekore », « N'Zerekore » et « Nzérékoré » sont trois chaines et une
/// seule region. Il est nul pour Siguiri et Beyla, auxquelles aucun code n'a encore
/// ete publie — l'inventer par symetrie serait un comblement, pas une donnee.
model Region {
  id             Int            @id @default(autoincrement())
  nom            String         @unique
  /// Code officiel a deux chiffres. Nul tant que le decret n'en attribue pas.
  code           String?        @unique
  /// Date d'entree en vigueur du decoupage qui cree cette region.
  validFrom      DateTime?
  /// Date de fin de validite. Nulle tant que la region est en vigueur.
  validTo        DateTime?
  /// Texte dont la region tient son existence, cite explicitement.
  source         String?
  sourceDate     DateTime?
  troncons       Troncon[]
  ouvrages       Ouvrage[]
  pointsNoirs    PointNoir[]
  postes         Poste[]
  chantiers      Chantier[]
  ordresTravaux  OrdreTravaux[]
  voiriesLocales VoirieLocale[]
  Mission        Mission[]

  @@map("regions")
}

// ===================== PATRIMOINE =====================

model Troncon {
  id                       String                                    @id @default(uuid())
  code                     String                                    @unique
  nom                      String
  classe                   ClasseRoute
  regionId                 Int
  region                   Region                                    @relation(fields: [regionId], references: [id])
  longueurKm               Float
  revetement               Revetement
  etat                     EtatPatrimoine                            @default(NON_EVALUE)
  pkDebut                  Float
  pkFin                    Float
  /// Section de referencement kilometrique, lue dans le code (« GN N0001 3-1216 »
  /// -> section 3). Les PK ne sont pas globaux sur l'axe : chaque section repart de
  /// zero. Mesure du 05/09/2026 : 88 sections sur 90 chainees sans trou ni
  /// recouvrement. Nulle pour la voirie promue, qui n'en a pas.
  sectionPk                String?
  traficMoyenJma           Int?
  traficDateComptage       DateTime?
  criticiteStrategique     Int?
  coutRehabEstime          Decimal?                                  @db.Decimal(12, 3)
  dateDerniereEvaluation   DateTime?
  prefecture               String?
  commune                  String?
  observations             String?
  // Provenance de l'ENREGISTREMENT (T2). Distincte du statut d'une valeur, qui est
  // porte par ValeurQualite : un troncon vient d'un lot d'import, mais chacun de ses
  // champs peut avoir ete constate, calcule ou jamais verifie.
  //
  // Mesure du 01/09/2026 : le journal d'audit ne contient AUCUNE creation pour les
  // 1 690 troncons. Leur origine n'etait donc nulle part. Elle est pourtant lisible
  // dans le code — `GN N*`, `*-OSM-*`, `RES-*` — d'ou sourceType IMPORT_CODE_PATTERN,
  // qui dit bien « deduit », pas « documente ».
  sourceType               SourceType?
  sourceReference          String?
  sourceConfidence         NiveauConfiance?
  sourceDetectedAt         DateTime?
  geom                     Unsupported("geometry(LineString,4326)")?
  propositionsLocalisation PropositionLocalisation[]
  voiriesLocales           VoirieLocale[]
  ouvrages                 Ouvrage[]
  pointsNoirs              PointNoir[]
  postes                   Poste[]
  chantiers                Chantier[]
  inspections              Inspection[]
  documents                Document[]
  marcheChantiers          MarcheChantier[]
  ordresTravaux            OrdreTravaux[]
  signalements             SignalementCitoyen[]
  deletedAt                DateTime?
  createdAt                DateTime                                  @default(now())
  updatedAt                DateTime                                  @updatedAt
  Observation              Observation[]

  @@index([regionId])
  @@index([etat])
  @@index([deletedAt])
  @@map("troncons")
}

model Ouvrage {
  id                     String                               @id @default(uuid())
  nom                    String
  type                   TypeOuvrage
  etat                   EtatPatrimoine                       @default(NON_EVALUE)
  regionId               Int
  region                 Region                               @relation(fields: [regionId], references: [id])
  tronconId              String?
  troncon                Troncon?                             @relation(fields: [tronconId], references: [id])
  pk                     Float?
  longueurM              Float?
  gabaritT               Float?
  anneeConstruction      Int?
  materiau               String?
  derniereInspectionDate DateTime?
  ficheNumero            String?
  code                   String?
  largeurM               Float?
  hauteurM               Float?
  nbTravees              Int?
  longueurTravee         Float?
  materiauAppuis         String?
  materiauTablier        String?
  materiauPiles          String?
  materiauAutre          String?
  remarques              String?
  travauxAPrevoir        String?
  photos                 String[]                             @default([])
  /// Provenance de l'enregistrement, alignee sur `Troncon`. NULL pour les 126
  /// ouvrages inventories par AGEROUTE — leur origine n'est documentee nulle part et
  /// leur en attribuer une retrospectivement serait inventer.
  /// « ouvrage_osm:<id> » pour un franchissement repris d'une source cartographique :
  /// c'est ce qui permet aux indicateurs de ne pas noyer l'inventaire de reference.
  sourceType             SourceType?
  sourceReference        String?
  sourceConfidence       NiveauConfiance?
  sourceDetectedAt       DateTime?
  geom                   Unsupported("geometry(Point,4326)")?
  inspections            Inspection[]
  ordresTravaux          OrdreTravaux[]
  deletedAt              DateTime?
  createdAt              DateTime                             @default(now())
  updatedAt              DateTime                             @updatedAt
  Observation            Observation[]

  @@index([regionId])
  @@index([etat])
  @@index([deletedAt])
  @@map("ouvrages")
}

model PointNoir {
  id                 String                               @id @default(uuid())
  description        String
  regionId           Int
  region             Region                               @relation(fields: [regionId], references: [id])
  tronconId          String?
  troncon            Troncon?                             @relation(fields: [tronconId], references: [id])
  pk                 Float?
  gravite            Gravite
  nbAccidents        Int                                  @default(0)
  causes             String?
  mesuresCorrectives String?
  geom               Unsupported("geometry(Point,4326)")?
  ordresTravaux      OrdreTravaux[]
  deletedAt          DateTime?
  createdAt          DateTime                             @default(now())
  updatedAt          DateTime                             @updatedAt

  @@index([regionId])
  @@index([deletedAt])
  @@map("points_noirs")
}

model Poste {
  id                    String                               @id @default(uuid())
  nom                   String
  type                  TypePoste
  regionId              Int
  region                Region                               @relation(fields: [regionId], references: [id])
  tronconId             String?
  troncon               Troncon?                             @relation(fields: [tronconId], references: [id])
  pk                    Float?
  statut                StatutPoste                          @default(EN_SERVICE)
  recettesMensuellesGnf BigInt?
  traficJma             Int?
  // Recuperation depuis le journal d'audit (T9). Dix suppressions du 01/07/2026 se
  // reduisent a six sites distincts — les autres etaient des doublons d'accentuation
  // (« Peage de Kilissi » et « Péage de Kilissi »). La suppression etait justifiee ;
  // l'absence de reprise ensuite ne l'etait pas.
  //
  // recoveryStatus reste PENDING_VALIDATION tant qu'un agent n'a pas confirme. Les
  // valeurs de trafic et de recettes NE SONT PAS reprises : deux postes portaient
  // exactement 3 200, tous les montants etaient ronds, aucun n'avait de coordonnees.
  // C'est la signature d'un jeu de demonstration, pas d'une campagne de comptage.
  historicalRecovered   Boolean                              @default(false)
  recoveredFrom         String?
  recoveryStatus        StatutRecuperation?
  geom                  Unsupported("geometry(Point,4326)")?
  deletedAt             DateTime?
  createdAt             DateTime                             @default(now())
  updatedAt             DateTime                             @updatedAt

  @@index([regionId])
  @@index([deletedAt])
  @@map("postes")
}

model Chantier {
  id                 String                                    @id @default(uuid())
  intitule           String
  entreprise         String
  bailleur           String?
  montantGnf         BigInt?
  regionId           Int
  region             Region                                    @relation(fields: [regionId], references: [id])
  tronconId          String?
  troncon            Troncon?                                  @relation(fields: [tronconId], references: [id])
  pkDebut            Float?
  pkFin              Float?
  avancementPct      Int                                       @default(0)
  statut             StatutChantier                            @default(PLANIFIE)
  dateDebutPrevue    DateTime?
  dateFinPrevue      DateTime?
  dateDebutReelle    DateTime?
  dateFinReelle      DateTime?
  numContrat         String?
  observations       String?
  // Niveau de localisation REEL (T6). Sans ce champ, la carte ne pouvait pas
  // distinguer un chantier dont on connait l'emprise d'un chantier dont on ne connait
  // que la region — et 50 chantiers dont on ne connait meme pas la region, rattaches
  // a une entree nommee « Non renseigne ».
  //
  // Valeur derivee, jamais saisie a la main : recalculee depuis geom, tronconId et pk.
  statutLocalisation StatutLocalisation                        @default(NONE)
  geom               Unsupported("geometry(LineString,4326)")?
  propositions       PropositionLocalisation[]
  marches            MarcheChantier[]
  deletedAt          DateTime?
  createdAt          DateTime                                  @default(now())
  updatedAt          DateTime                                  @updatedAt
  Mission            Mission[]
  Observation        Observation[]

  @@index([regionId])
  @@index([deletedAt])
  @@map("chantiers")
}

model Inspection {
  id                 String         @id @default(uuid())
  tronconId          String?
  troncon            Troncon?       @relation(fields: [tronconId], references: [id])
  ouvrageId          String?
  ouvrage            Ouvrage?       @relation(fields: [ouvrageId], references: [id])
  inspecteurId       String
  inspecteur         User           @relation(fields: [inspecteurId], references: [id])
  dateInspection     DateTime
  etatObserve        EtatPatrimoine
  defautsConstates   String?
  recommandations    String?
  photos             String[]       @default([])
  // Position relevee sur le terrain. precisionM porte l'incertitude annoncee par
  // l'appareil : une position a plus ou moins 500 m ne vaut pas une position a 5 m,
  // et le distinguer evite de traiter la premiere comme exacte.
  lat                Float?
  lon                Float?
  precisionM         Float?
  // Identifiant genere par le CLIENT avant tout envoi (T7). C'est la cle
  // d'idempotence : le serveur refuse une seconde creation portant le meme
  // identifiant et renvoie l'inspection deja creee.
  //
  // La correction cote client — persister l'identifiant serveur des la creation
  // reussie — supprime la cause la plus frequente du doublon, mais elle ne protege
  // pas de tout : une reponse perdue en chemin laisse le client croire a un echec
  // alors que le serveur a bien enregistre. Seule une garantie SERVEUR ferme ce cas.
  clientInspectionId String?        @unique
  deletedAt          DateTime?
  createdAt          DateTime       @default(now())

  @@index([tronconId])
  @@index([ouvrageId])
  @@map("inspections")
}

// ===================== BASE DOCUMENTAIRE =====================

model Document {
  id        String       @id @default(uuid())
  titre     String
  type      DocumentType
  annee     Int?
  tronconId String?
  troncon   Troncon?     @relation(fields: [tronconId], references: [id])
  fileName  String
  filePath  String
  mimeType  String
  sizeBytes Int
  deletedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([tronconId])
  @@index([type])
  @@index([deletedAt])
  @@map("documents")
}

// ===================== MARCHÉS & BAILLEURS =====================

model Bailleur {
  id        Int       @id @default(autoincrement())
  nom       String    @unique
  type      String    @default("autre")
  deletedAt DateTime?
  marches   Marche[]

  @@map("bailleurs")
}

model Marche {
  id                        String             @id @default(uuid()) @db.Uuid
  intitule                  String
  bailleurId                Int?
  bailleur                  Bailleur?          @relation(fields: [bailleurId], references: [id])
  montantTotal              BigInt?
  devise                    DeviseMarche       @default(GNF)
  dateSignature             DateTime?
  dateDebutPrevue           DateTime?
  dateFinPrevue             DateTime?
  dateReceptionProvisoire   DateTime?
  garantieBonneExecutionExp DateTime?
  tauxPenaliteRetardPct     Float?
  statut                    StatutMarche       @default(PLANIFIE)
  chantiers                 MarcheChantier[]
  avancements               AvancementMarche[]
  decomptes                 Decompte[]
  deletedAt                 DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@index([bailleurId])
  @@index([statut])
  @@index([deletedAt])
  @@map("marches")
}

model Decompte {
  id           String         @id @default(uuid()) @db.Uuid
  marcheId     String         @db.Uuid
  marche       Marche         @relation(fields: [marcheId], references: [id], onDelete: Cascade)
  numero       Int
  type         DecompteType   @default(DECOMPTE)
  montantGnf   BigInt
  dateEmission DateTime?
  datePaiement DateTime?
  statut       DecompteStatut @default(EMIS)
  observations String?
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([marcheId])
  @@index([statut])
  @@map("decomptes")
}

model MarcheChantier {
  marcheId   String   @db.Uuid
  marche     Marche   @relation(fields: [marcheId], references: [id], onDelete: Cascade)
  chantierId String
  chantier   Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  tronconId  String?
  troncon    Troncon? @relation(fields: [tronconId], references: [id])

  @@id([marcheId, chantierId])
  @@map("marches_chantiers")
}

model AvancementMarche {
  id                       Int      @id @default(autoincrement())
  marcheId                 String   @db.Uuid
  marche                   Marche   @relation(fields: [marcheId], references: [id], onDelete: Cascade)
  periode                  DateTime
  avancementPhysiquePrevu  Float    @default(0)
  avancementPhysiqueReel   Float    @default(0)
  avancementFinancierPrevu Float    @default(0)
  avancementFinancierReel  Float    @default(0)
  createdAt                DateTime @default(now())

  @@unique([marcheId, periode])
  @@index([marcheId])
  @@map("avancement_marche")
}

// ===================== HISTORIQUE RÉSEAU =====================

model IndicateurReseauHistorique {
  id                  Int      @id @default(autoincrement())
  periode             DateTime @unique
  pctBon              Float    @default(0)
  pctMoyen            Float    @default(0)
  pctMauvais          Float    @default(0)
  pctCritique         Float    @default(0)
  pctNonEvalue        Float    @default(0)
  lineaireTraiteKm    Float    @default(0)
  budgetEngageCumul   BigInt   @default(0)
  budgetDecaisseCumul BigInt   @default(0)
  createdAt           DateTime @default(now())

  @@index([periode])
  @@map("indicateurs_reseau_historique")
}

// ===================== AUDIT =====================

// ===================== ORDRES DE TRAVAUX =====================

// Maille intervention entre l'alerte et le chantier : petit périmètre exécuté en régie
// ou petite entreprise. Au-delà d'un seuil de coût (paramétrable), conversion en chantier.
model OrdreTravaux {
  id               String              @id @default(uuid())
  numero           String              @unique
  titre            String
  description      String?
  typeIntervention TypeInterventionOT
  priorite         PrioriteOT          @default(NORMALE)
  statut           StatutOT            @default(BROUILLON)
  regionId         Int?
  region           Region?             @relation(fields: [regionId], references: [id])
  tronconId        String?
  troncon          Troncon?            @relation(fields: [tronconId], references: [id])
  ouvrageId        String?
  ouvrage          Ouvrage?            @relation(fields: [ouvrageId], references: [id])
  pointNoirId      String?
  pointNoir        PointNoir?          @relation(fields: [pointNoirId], references: [id])
  signalementId    String?
  signalement      SignalementCitoyen? @relation(fields: [signalementId], references: [id])
  chantierId       String?
  pkLocalisation   Float?
  lat              Float?
  lon              Float?
  coutEstimeGnf    BigInt?
  coutReelGnf      BigInt?
  assigneAId       String?
  assigneA         User?               @relation("OtAssigne", fields: [assigneAId], references: [id])
  entreprise       String?
  dateEcheance     DateTime?
  dateDebutReel    DateTime?
  dateFinReelle    DateTime?
  creeParId        String
  creePar          User                @relation("OtCreateur", fields: [creeParId], references: [id])
  photos           OtPhoto[]
  historique       OtHistorique[]
  deletedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([statut])
  @@index([priorite])
  @@index([regionId])
  @@index([assigneAId])
  @@index([deletedAt])
  @@map("ordres_travaux")
}

// Photos avant/pendant/après géolocalisées : preuve d'exécution pour audits et bailleurs.
model OtPhoto {
  id         String       @id @default(uuid())
  otId       String
  ot         OrdreTravaux @relation(fields: [otId], references: [id], onDelete: Cascade)
  fileName   String
  type       TypePhotoOT  @default(AVANT)
  lat        Float?
  lon        Float?
  priseLe    DateTime     @default(now())
  priseParId String?
  prisePar   User?        @relation(fields: [priseParId], references: [id])
  // P1-02 : une photo d'OT est une preuve d'exécution — retrait logique, pas DELETE.
  deletedAt  DateTime?

  @@index([otId])
  @@map("ot_photos")
}

model OtHistorique {
  id            Int          @id @default(autoincrement())
  otId          String
  ot            OrdreTravaux @relation(fields: [otId], references: [id], onDelete: Cascade)
  action        String
  ancienStatut  StatutOT?
  nouveauStatut StatutOT?
  commentaire   String?
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([otId])
  @@map("ot_historique")
}

// ===================== COURBES DE DÉGRADATION =====================

// Chaîne de Markov à 4 états (Bon→Moyen→Mauvais→Critique) : probabilités annuelles de
// transition par famille revêtement × classe de trafic. Valeurs initiales HDM-4
// simplifiées, à recaler sur les inspections réelles (source=recale_donnees).
model MatriceDegradation {
  id                   Int      @id @default(autoincrement())
  familleRevetement    String
  classeTrafic         String
  pBonVersMoyen        Float
  pMoyenVersMauvais    Float
  pMauvaisVersCritique Float
  source               String   @default("standard_initial")
  version              Int      @default(1)
  updatedAt            DateTime @updatedAt

  @@unique([familleRevetement, classeTrafic])
  @@map("matrices_degradation")
}

// Barèmes de coût d'intervention par état de départ (M GNF/km) — alimente le ratio
// "coût de report" (entretenir tôt coûte ~10× moins que reconstruire).
model BaremeIntervention {
  id                Int    @id @default(autoincrement())
  familleRevetement String
  etatDepart        String
  typeIntervention  String
  coutKmGnf         BigInt

  @@unique([familleRevetement, etatDepart])
  @@map("baremes_intervention")
}

// ===================== SIGNALEMENTS CITOYENS =====================

model SignalementCitoyen {
  id                  String               @id @default(uuid())
  numeroPublic        String               @unique
  canal               CanalSignalement     @default(PWA)
  typeProbleme        TypeProbleme
  description         String?
  lat                 Float?
  lon                 Float?
  localisationTexte   String?
  tronconId           String?
  troncon             Troncon?             @relation(fields: [tronconId], references: [id])
  photoFileName       String?
  statut              StatutSignalement    @default(NOUVEAU)
  motifRejet          String?
  signalementParentId String?
  signalementParent   SignalementCitoyen?  @relation("Doublons", fields: [signalementParentId], references: [id])
  doublons            SignalementCitoyen[] @relation("Doublons")
  contactTel          String?
  qualifieParId       String?
  qualifiePar         User?                @relation(fields: [qualifieParId], references: [id])
  ots                 OrdreTravaux[]
  qualifieLe          DateTime?
  resoluLe            DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([statut])
  @@index([typeProbleme])
  @@map("signalements_citoyens")
}

// ===================== PARAMÈTRES SYSTÈME =====================

// Store clé/valeur générique pour les réglages configurables depuis l'interface (SMTP,
// et futures catégories) — évite une migration à chaque nouveau paramètre. La valeur est
// une chaîne JSON ; les champs sensibles qu'elle contient (mot de passe SMTP...) sont
// chiffrés avant écriture (voir src/lib/crypto.ts), jamais stockés en clair.
model AppSetting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ===================== QUALITE DES DONNEES =====================

/// Ce que l'on sait d'UNE valeur d'UN champ d'UN enregistrement (T3, T4).
///
/// POURQUOI UNE TABLE ET PAS DES COLONNES
///
/// Six champs alimentent une decision — etat, longueur, revetement, trafic,
/// criticite, cout. Leur attacher statut, source, methode, date, auteur et confiance
/// en colonnes ferait trente-six colonnes sur `troncons`, puis autant sur `ouvrages`.
/// Une table separee tient la meme information sans toucher une seule colonne
/// existante : la migration n'ecrit rien dans les donnees metier, et son retrait se
/// reduit a un DROP TABLE.
///
/// LA GRANULARITE EST LE POINT
///
/// Un troncon typique a aujourd'hui une geometrie VERIFIEE, une longueur ABSENTE et
/// un revetement CONTREDIT. Un statut unique porte par l'objet devrait choisir entre
/// ces trois niveaux et perdrait ce qui compte.
///
/// LA DATE EST OBLIGATOIRE, PAS DECORATIVE
///
/// Mesure du 01/09/2026 : 3 dates metier renseignees sur 4 970 attendues. Les 647
/// troncons dont l'etat est connu ne sont donc pas comparables entre eux — un « BON »
/// de cette annee et un « BON » d'il y a dix ans occupent la meme case. Un statut
/// OBSERVED sans `observedAt` ne vaut pas mieux que pas de statut du tout.
model ValeurQualite {
  id           String           @id @default(uuid())
  /// Nom du modele Prisma : "Troncon", "Ouvrage", "Chantier".
  entityType   String
  entityId     String
  /// Nom du champ tel qu'il figure au schema : "revetement", "etat", "longueurKm".
  champ        String
  statut       StatutValeur
  /// D'ou vient la valeur : "IMPORT_INITIAL", "INSPECTION_TERRAIN", "ST_Length(geom)".
  source       String?
  /// Comment elle a ete etablie : "RELEVE_TERRAIN", "CALCUL_GEOMETRIQUE", "IMPORT".
  methode      String?
  /// Date du CONSTAT, jamais la date d'ecriture de la ligne. `createdAt` dit quand on
  /// l'a saisi ; `observedAt` dit quand le fait a ete constate. Les confondre est
  /// exactement l'erreur que ce modele existe pour empecher.
  observedAt   DateTime?
  observedById String?
  observedBy   User?            @relation(fields: [observedById], references: [id])
  confiance    NiveauConfiance?
  /// Ce qui contredit la valeur, quand statut vaut CONFLICTING.
  note         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([entityType, entityId, champ])
  @@index([entityType, champ, statut])
  @@index([statut])
  @@map("valeurs_qualite")
}

/// Localisation PROPOSEE pour un chantier, jamais appliquee seule (T5).
///
/// 36 intitules de chantiers portent a la fois la route et les PK de debut et de fin :
/// « lot 12 : travaux de cantonnage manuel de la route PK24 - PK66 RN5 (42 km) ».
/// Les 1 690 troncons ayant leurs PK renseignes, la projection est calculable.
///
/// Mais les intitules sont du texte libre et piegent une extraction naive :
/// « PK50-Marela (PK103) » mele un PK et une localite dans la meme expression. Une
/// proposition attend donc toujours la decision d'un agent, et la geometrie du
/// chantier n'est ecrite qu'a la validation.
///
/// `longueurCiteeKm` sert de controle : 221 intitules portent une longueur, et
/// l'ecart avec la longueur de l'emprise calculee dit si l'extraction a vu juste.
model PropositionLocalisation {
  id                 String                                    @id @default(uuid())
  chantierId         String
  chantier           Chantier                                  @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  statut             StatutProposition                         @default(PROPOSED)
  /// "INTITULE_ROUTE_PK", "INTITULE_ROUTE_SEULE".
  methode            String
  /// L'intitule exact dont la proposition est tiree, pour que l'agent juge sur piece.
  sourceTexte        String
  confiance          NiveauConfiance
  tronconId          String?
  troncon            Troncon?                                  @relation(fields: [tronconId], references: [id])
  pkDebut            Float?
  pkFin              Float?
  longueurCiteeKm    Float?
  /// Pourquoi la proposition est ce qu'elle est, en clair : « section 3 identifiée »,
  /// « 3 sections compatibles, l'intitulé ne dit pas laquelle », « 12 tronçons
  /// candidats, aucun ne couvre l'emprise ». Sans ce champ, l'agent devait refaire le
  /// raisonnement que le script avait déjà fait.
  motif              String?
  /// Section de référencement retenue, quand une seule couvre l'emprise. Distincte du
  /// motif parce que c'est une clé, pas une phrase : « les propositions dont la
  /// section est identifiée » est la requête qui sert à distribuer le travail.
  sectionPk          String?
  longueurCalculeeKm Float?
  ecartPct           Float?
  geom               Unsupported("geometry(LineString,4326)")?
  createdAt          DateTime                                  @default(now())
  decidedAt          DateTime?
  decidedById        String?
  decidedBy          User?                                     @relation(fields: [decidedById], references: [id])
  motifRejet         String?

  @@index([chantierId])
  @@index([statut])
  @@map("propositions_localisation")
}

// ===================== VOIRIE LOCALE (source externe) =====================

enum SourceVoirie {
  OSM
  IMPORT_AGEROUTE
  SAISIE_APPLICATIVE
}

/// Regroupement des 21 valeurs de NATURE d'OpenStreetMap.
///
/// INFERE : aucun champ source ne porte ce regroupement. `CL_ADMIN` vaut « Autre »
/// sur les 262 656 objets, et NATURE decrit la praticabilite, pas le statut. Ce
/// classement est une lecture, pas une donnee.
enum CategorieVoirie {
  VOIE_RAPIDE
  PRINCIPALE
  SECONDAIRE
  TERTIAIRE
  VOIE_LOCALE
  RESIDENTIELLE
  ACCES
  CHEMIN
  SENTIER
  PIETON
  INCONNU
}

/// Cycle de vie d'une voie externe.
///
/// VALIDEE ne signifie PAS que la voie devient RN/RR/RU. C'est une validation
/// CARTOGRAPHIQUE — le trace est juge correct. Le classement institutionnel est une
/// decision distincte, materialisee par `tronconId`.
enum StatutVoirie {
  SOURCE_EXTERNE
  CANDIDATE
  VALIDEE
  REJETEE
  ARCHIVEE
}

/// Voirie issue d'une source cartographique externe.
///
/// N'EST PAS un actif du patrimoine AGEROUTE. Table separee de `Troncon` pour trois
/// raisons mesurees : 262 656 lignes multiplieraient par 156 tous les indicateurs
/// existants ; les contraintes non nulles de Troncon (regionId, longueurKm,
/// revetement, etat, pkDebut, pkFin) exigeraient des valeurs inventees ; et la
/// distinction entre actif AGEROUTE et donnee externe doit tenir dans le temps.
model VoirieLocale {
  id String @id @default(uuid())

  // Provenance, obligatoire.
  source     SourceVoirie
  sourceId   String
  sourceDate DateTime?
  importedAt DateTime     @default(now())
  /// Lot d'import, pour retrouver d'ou vient une ligne. Ex : « A_OSM_RESEAU_ROUTIER 2023-03-08 ».
  importLot  String

  // Attributs de la source, tels quels.
  /// Valeur NATURE brute, non traduite — la trace de ce que la source disait.
  nature    String
  /// 0,4 % renseignes dans le jeu 2023.
  nom       String?
  /// NUMERO, 0,6 % renseignes.
  reference String?
  sens      String?

  // Lecture derivee, marquee comme telle.
  categorie          CategorieVoirie
  longueurCalculeeKm Float

  // Rattachement faible. Nul tant qu'aucune methode ne l'a etabli : la source ne
  // porte aucun decoupage administratif.
  regionId      Int?
  region        Region? @relation(fields: [regionId], references: [id])
  regionMethode String?

  // Cycle de vie.
  statut    StatutVoirie @default(SOURCE_EXTERNE)
  /// Rempli quand la voie devient un actif AGEROUTE. L'identifiant source ne devient
  /// JAMAIS un identifiant BDRI : la relation est conservee, l'identite non.
  tronconId String?
  troncon   Troncon?     @relation(fields: [tronconId], references: [id])

  geom Unsupported("geometry(LineString,4326)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, sourceId])
  @@index([categorie])
  @@index([statut])
  @@map("voirie_locale")
}

// ─────────────────────────────────────────────────────────────────────────────
// AGEROUTE ROAD — socle terrain
//
// POURQUOI CES MODELES, ET POURQUOI MAINTENANT
//
// La collecte terrain existe deja, mais sous une forme qui ne porte pas le besoin :
// une Inspection est attachee a UN troncon ou UN ouvrage, saisie dans un formulaire,
// sans notion de deplacement ni de campagne. Le terrain reel est une MISSION — une
// equipe, un vehicule, une zone, un trajet — au cours de laquelle des observations
// tombent la ou elles tombent.
//
// Mesure du 07/10/2026 : aucun de ces concepts n'existe au schema. Mission, Appareil,
// Trace et Observation sont absents des 27 modeles. C'est la premiere brique du
// programme, et tout le reste s'y accroche.
//
// LA LANGUE
//
// Le dossier V2 nomme ces entites en anglais (FieldMission, Track, Observation). Les
// 27 modeles existants sont en francais, sans exception. Un schema a moitie bilingue
// coute plus cher a lire qu'il ne gagne en fidelite a un document : on garde le
// francais, « Observation » se trouvant etre identique dans les deux.
//
// L'IDEMPOTENCE N'EST PAS INVENTEE ICI
//
// Inspection.clientInspectionId porte deja la regle : le client genere un identifiant
// AVANT d'envoyer, le serveur refuse une seconde creation sous le meme. Elle est
// generalisee en clientOperationId, pas remplacee. Sans elle, une reponse perdue en
// chemin — le cas courant sur un reseau guineen — produit un doublon a chaque reessai.
//
// CE QUI N'EST PAS LA
//
// Le modele Asset generique du dossier. Il suppose de faire de Ouvrage une
// specialisation, donc de toucher 1 089 lignes en production et tous les ecrans qui
// les lisent. Ce n'est pas un premier increment, c'est une migration a part entiere.
// Observation.ouvrageId suffit en attendant.
// ─────────────────────────────────────────────────────────────────────────────

enum TypeMission {
  INSPECTION
  INVENTAIRE
  SURVEILLANCE
  CONTROLE_CHANTIER
  RECEPTION
  SECURITE
  URGENCE
  RELEVE_SIG
}

/// Cycle de vie d'une mission. TELECHARGEE et SYNC_EN_ATTENTE ne sont pas decoratifs :
/// ils distinguent « l'agent peut partir » de « l'agent est rentre mais rien n'est
/// encore remonte », deux situations qu'un responsable doit voir differemment.
enum StatutMission {
  BROUILLON
  PLANIFIEE
  TELECHARGEE
  EN_COURS
  SUSPENDUE
  TERMINEE
  SYNC_EN_ATTENTE
  ANNULEE
}

enum TypeObservation {
  DEGRADATION
  CHAUSSEE
  ASSAINISSEMENT
  SIGNALISATION
  OUVRAGE
  SECURITE
  TRAFIC
  ENVIRONNEMENT
  CHANTIER
  INCIDENT
  AUTRE
}

/// Une observation de terrain n'est PAS une donnee officielle tant qu'elle n'a pas ete
/// validee. C'est la regle centrale du dossier V2, et elle prolonge ce que
/// PropositionLocalisation fait deja pour la geometrie des chantiers.
enum StatutObservation {
  BROUILLON
  PROPOSEE
  VALIDEE
  REJETEE
  CONVERTIE
}

enum StatutSync {
  EN_ATTENTE
  EN_COURS
  SYNCHRONISE
  CONFLIT
  REJETE
}

/// Appareil enregistre, pour qu'une session mobile soit revocable sans toucher au
/// compte. Un telephone perdu se revoque ; son porteur garde son acces web.
model Appareil {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  nom        String?
  plateforme String
  modele     String?
  versionOs  String?
  versionApp String?

  dernierVuA DateTime?
  revoqueA   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  missions   Mission[]
  traces     Trace[]
  operations OperationSync[]

  @@index([userId])
  @@index([revoqueA])
  @@map("appareils")
}

model Mission {
  id       String        @id @default(uuid())
  code     String        @unique
  intitule String
  type     TypeMission
  statut   StatutMission @default(BROUILLON)

  createurId String
  createur   User    @relation("MissionCreateur", fields: [createurId], references: [id])
  assigneId  String?
  assigne    User?   @relation("MissionAssigne", fields: [assigneId], references: [id])

  appareilId String?
  appareil   Appareil? @relation(fields: [appareilId], references: [id])

  regionId   Int?
  region     Region?   @relation(fields: [regionId], references: [id])
  chantierId String?
  chantier   Chantier? @relation(fields: [chantierId], references: [id])

  vehicule String?
  equipe   String?

  debutPrevu DateTime?
  finPrevue  DateTime?
  debutReel  DateTime?
  finReelle  DateTime?

  /// Emprise de la mission. PREMIER polygone du schema : tout le reste est en Point ou
  /// LineString. La colonne est posee par la migration, Prisma ne sachant pas
  /// manipuler les types geometriques.
  emprise    Unsupported("geometry(Polygon,4326)")?
  /// Itineraire prevu, distinct des traces reellement parcourues.
  itineraire Unsupported("geometry(LineString,4326)")?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  traces       Trace[]
  observations Observation[]

  @@index([statut])
  @@index([assigneId])
  @@index([regionId])
  @@index([deletedAt])
  @@map("missions")
}

/// Un trajet enregistre pendant une mission. Separe de la mission parce qu'une mission
/// peut comporter plusieurs trajets : aller, retour, deviation.
model Trace {
  id        String  @id @default(uuid())
  missionId String
  mission   Mission @relation(fields: [missionId], references: [id])

  userId     String
  user       User      @relation(fields: [userId], references: [id])
  appareilId String?
  appareil   Appareil? @relation(fields: [appareilId], references: [id])

  debutA DateTime
  finA   DateTime?

  distanceKm     Float?
  dureeSec       Int?
  vitesseMoyenne Float?
  vitesseMax     Float?

  geom Unsupported("geometry(LineString,4326)")?

  createdAt DateTime @default(now())

  points PointTrace[]

  @@index([missionId])
  @@index([userId])
  @@map("traces")
}

/// Un point GPS brut, conserve tel que l'appareil l'a rendu, precision comprise : une
/// position a plus ou moins 500 m ne vaut pas une position a 5 m, et le moteur
/// d'appariement doit pouvoir refuser de conclure. Mesure du 07/10/2026 : a 15 m
/// d'erreur en milieu urbain, l'appariement se trompe de rue.
model PointTrace {
  id      String @id @default(uuid())
  traceId String
  trace   Trace  @relation(fields: [traceId], references: [id], onDelete: Cascade)

  horodatage DateTime
  lat        Float
  lon        Float
  altitude   Float?
  vitesse    Float?
  cap        Float?
  precisionM Float?
  satellites Int?
  hdop       Float?

  geom Unsupported("geometry(Point,4326)")?

  @@index([traceId, horodatage])
  @@map("points_trace")
}

model Observation {
  id String @id @default(uuid())

  /// Cle d'idempotence generee par le CLIENT avant tout envoi. Meme regle que
  /// Inspection.clientInspectionId, generalisee : une reponse perdue en chemin ne doit
  /// pas produire un doublon au reessai.
  clientOperationId String @unique

  missionId String?
  mission   Mission? @relation(fields: [missionId], references: [id])

  agentId String
  agent   User   @relation("ObservationAgent", fields: [agentId], references: [id])

  type        TypeObservation
  statut      StatutObservation @default(PROPOSEE)
  gravite     Gravite?
  description String?

  /// Rattachements, tous facultatifs : une observation peut tomber la ou aucun objet
  /// n'est encore inventorie, et c'est precisement ce qu'on veut savoir.
  tronconId  String?
  troncon    Troncon?  @relation(fields: [tronconId], references: [id])
  ouvrageId  String?
  ouvrage    Ouvrage?  @relation(fields: [ouvrageId], references: [id])
  chantierId String?
  chantier   Chantier? @relation(fields: [chantierId], references: [id])

  /// PK apparie. Nul tant que le moteur ne sait pas conclure — mesure du 07/10/2026 :
  /// seuls 551 des 1 691 troncons du reseau classe portent des PK exploitables.
  pk Float?

  lat        Float?
  lon        Float?
  precisionM Float?
  geom       Unsupported("geometry(Point,4326)")?

  /// Confiance de l'appariement, entre 0 et 1. Distincte de la gravite : l'une dit ce
  /// qu'on a vu, l'autre a quel point on sait ou.
  confianceAppariement Float?

  observeA     DateTime
  valideeA     DateTime?
  validateurId String?
  validateur   User?     @relation("ObservationValidateur", fields: [validateurId], references: [id])
  motifRejet   String?

  /// Version pour la detection de conflit a la synchronisation. Une modification partie
  /// d'une version perimee ne doit jamais ecraser en silence.
  version Int @default(1)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  medias MediaObservation[]

  @@index([missionId])
  @@index([tronconId])
  @@index([statut])
  @@index([deletedAt])
  @@map("observations")
}

/// Photo, video ou audio rattache a une observation. sha256 est unique : le meme
/// fichier renvoye deux fois apres une coupure ne cree pas deux lignes.
model MediaObservation {
  id            String      @id @default(uuid())
  observationId String
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  type           String
  chemin         String
  cheminVignette String?
  sha256         String  @unique
  mimeType       String
  tailleOctets   Int

  lat        Float?
  lon        Float?
  precisionM Float?
  cap        Float?
  capturedA  DateTime?

  createdAt DateTime @default(now())

  @@index([observationId])
  @@map("medias_observation")
}

/// Une operation en attente de synchronisation, telle que l'appareil l'a produite.
/// operationId est unique : rejouer la meme operation ne la rejoue pas.
model OperationSync {
  id          String @id @default(uuid())
  operationId String @unique

  appareilId String
  appareil   Appareil @relation(fields: [appareilId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  entityType String
  entityId   String
  operation  String

  payload     Json
  baseVersion Int?

  statut         StatutSync @default(EN_ATTENTE)
  tentatives     Int        @default(0)
  derniereErreur String?

  createdAt DateTime  @default(now())
  traiteeA  DateTime?

  @@index([appareilId, statut])
  @@index([entityType, entityId])
  @@map("operations_sync")
}

/// Un conflit non resolu. Il n'est JAMAIS tranche automatiquement sur une donnee
/// patrimoniale : les deux versions sont conservees et un responsable decide.
model ConflitSync {
  id          String @id @default(uuid())
  operationId String

  entityType String
  entityId   String

  payloadLocal   Json
  payloadServeur Json

  resolution  String?
  resoluParId String?
  resoluA     DateTime?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@map("conflits_sync")
}
