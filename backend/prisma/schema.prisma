  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ===================== QUALITE DES DONNEES =====================

/// Ce que l'on sait d'UNE valeur d'UN champ d'UN enregistrement (T3, T4).
///
/// POURQUOI UNE TABLE ET PAS DES COLONNES
///
/// Six champs alimentent une decision — etat, longueur, revetement, trafic,
/// criticite, cout. Leur attacher statut, source, methode, date, auteur et confiance
/// en colonnes ferait trente-six colonnes sur `troncons`, puis autant sur `ouvrages`.
/// Une table separee tient la meme information sans toucher une seule colonne
/// existante : la migration n'ecrit rien dans les donnees metier, et son retrait se
/// reduit a un DROP TABLE.
///
/// LA GRANULARITE EST LE POINT
///
/// Un troncon typique a aujourd'hui une geometrie VERIFIEE, une longueur ABSENTE et
/// un revetement CONTREDIT. Un statut unique porte par l'objet devrait choisir entre
/// ces trois niveaux et perdrait ce qui compte.
///
/// LA DATE EST OBLIGATOIRE, PAS DECORATIVE
///
/// Mesure du 01/09/2026 : 3 dates metier renseignees sur 4 970 attendues. Les 647
/// troncons dont l'etat est connu ne sont donc pas comparables entre eux — un « BON »
/// de cette annee et un « BON » d'il y a dix ans occupent la meme case. Un statut
/// OBSERVED sans `observedAt` ne vaut pas mieux que pas de statut du tout.
model ValeurQualite {
  id           String           @id @default(uuid())
  /// Nom du modele Prisma : "Troncon", "Ouvrage", "Chantier".
  entityType   String
  entityId     String
  /// Nom du champ tel qu'il figure au schema : "revetement", "etat", "longueurKm".
  champ        String
  statut       StatutValeur
  /// D'ou vient la valeur : "IMPORT_INITIAL", "INSPECTION_TERRAIN", "ST_Length(geom)".
  source       String?
  /// Comment elle a ete etablie : "RELEVE_TERRAIN", "CALCUL_GEOMETRIQUE", "IMPORT".
  methode      String?
  /// Date du CONSTAT, jamais la date d'ecriture de la ligne. `createdAt` dit quand on
  /// l'a saisi ; `observedAt` dit quand le fait a ete constate. Les confondre est
  /// exactement l'erreur que ce modele existe pour empecher.
  observedAt   DateTime?
  observedById String?
  observedBy   User?            @relation(fields: [observedById], references: [id])
  confiance    NiveauConfiance?
  /// Ce qui contredit la valeur, quand statut vaut CONFLICTING.
  note         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([entityType, entityId, champ])
  @@index([entityType, champ, statut])
  @@index([statut])
  @@map("valeurs_qualite")
}

/// Localisation PROPOSEE pour un chantier, jamais appliquee seule (T5).
///
/// 36 intitules de chantiers portent a la fois la route et les PK de debut et de fin :
/// « lot 12 : travaux de cantonnage manuel de la route PK24 - PK66 RN5 (42 km) ».
/// Les 1 690 troncons ayant leurs PK renseignes, la projection est calculable.
///
/// Mais les intitules sont du texte libre et piegent une extraction naive :
/// « PK50-Marela (PK103) » mele un PK et une localite dans la meme expression. Une
/// proposition attend donc toujours la decision d'un agent, et la geometrie du
/// chantier n'est ecrite qu'a la validation.
///
/// `longueurCiteeKm` sert de controle : 221 intitules portent une longueur, et
/// l'ecart avec la longueur de l'emprise calculee dit si l'extraction a vu juste.
model PropositionLocalisation {
  id                 String                                    @id @default(uuid())
  chantierId         String
  chantier           Chantier                                  @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  statut             StatutProposition                         @default(PROPOSED)
  /// "INTITULE_ROUTE_PK", "INTITULE_ROUTE_SEULE".
  methode            String
  /// L'intitule exact dont la proposition est tiree, pour que l'agent juge sur piece.
  sourceTexte        String
  confiance          NiveauConfiance
  tronconId          String?
  troncon            Troncon?                                  @relation(fields: [tronconId], references: [id])
  pkDebut            Float?
  pkFin              Float?
  longueurCiteeKm    Float?
  /// Pourquoi la proposition est ce qu'elle est, en clair : « section 3 identifiée »,
  /// « 3 sections compatibles, l'intitulé ne dit pas laquelle », « 12 tronçons
  /// candidats, aucun ne couvre l'emprise ». Sans ce champ, l'agent devait refaire le
  /// raisonnement que le script avait déjà fait.
  motif              String?
  /// Section de référencement retenue, quand une seule couvre l'emprise. Distincte du
  /// motif parce que c'est une clé, pas une phrase : « les propositions dont la
  /// section est identifiée » est la requête qui sert à distribuer le travail.
  sectionPk          String?
  longueurCalculeeKm Float?
  ecartPct           Float?
  geom               Unsupported("geometry(LineString,4326)")?
  createdAt          DateTime                                  @default(now())
  decidedAt          DateTime?
  decidedById        String?
  decidedBy          User?                                     @relation(fields: [decidedById], references: [id])
  motifRejet         String?

  @@index([chantierId])
  @@index([statut])
  @@map("propositions_localisation")
}

// ===================== VOIRIE LOCALE (source externe) =====================

enum SourceVoirie {
  OSM
  IMPORT_AGEROUTE
  SAISIE_APPLICATIVE
}

/// Regroupement des 21 valeurs de NATURE d'OpenStreetMap.
///
/// INFERE : aucun champ source ne porte ce regroupement. `CL_ADMIN` vaut « Autre »
/// sur les 262 656 objets, et NATURE decrit la praticabilite, pas le statut. Ce
/// classement est une lecture, pas une donnee.
enum CategorieVoirie {
  VOIE_RAPIDE
  PRINCIPALE
  SECONDAIRE
  TERTIAIRE
  VOIE_LOCALE
  RESIDENTIELLE
  ACCES
  CHEMIN
  SENTIER
  PIETON
  INCONNU
}

/// Cycle de vie d'une voie externe.
///
/// VALIDEE ne signifie PAS que la voie devient RN/RR/RU. C'est une validation
/// CARTOGRAPHIQUE — le trace est juge correct. Le classement institutionnel est une
/// decision distincte, materialisee par `tronconId`.
enum StatutVoirie {
  SOURCE_EXTERNE
  CANDIDATE
  VALIDEE
  REJETEE
  ARCHIVEE
}

/// Voirie issue d'une source cartographique externe.
///
/// N'EST PAS un actif du patrimoine AGEROUTE. Table separee de `Troncon` pour trois
/// raisons mesurees : 262 656 lignes multiplieraient par 156 tous les indicateurs
/// existants ; les contraintes non nulles de Troncon (regionId, longueurKm,
/// revetement, etat, pkDebut, pkFin) exigeraient des valeurs inventees ; et la
/// distinction entre actif AGEROUTE et donnee externe doit tenir dans le temps.
model VoirieLocale {
  id String @id @default(uuid())

  // Provenance, obligatoire.
  source     SourceVoirie
  sourceId   String
  sourceDate DateTime?
  importedAt DateTime     @default(now())
  /// Lot d'import, pour retrouver d'ou vient une ligne. Ex : « A_OSM_RESEAU_ROUTIER 2023-03-08 ».
  importLot  String

  // Attributs de la source, tels quels.
  /// Valeur NATURE brute, non traduite — la trace de ce que la source disait.
  nature    String
  /// 0,4 % renseignes dans le jeu 2023.
  nom       String?
  /// NUMERO, 0,6 % renseignes.
  reference String?
  sens      String?

  // Lecture derivee, marquee comme telle.
  categorie          CategorieVoirie
  longueurCalculeeKm Float

  // Rattachement faible. Nul tant qu'aucune methode ne l'a etabli : la source ne
  // porte aucun decoupage administratif.
  regionId      Int?
  region        Region? @relation(fields: [regionId], references: [id])
  regionMethode String?

  // Cycle de vie.
  statut    StatutVoirie @default(SOURCE_EXTERNE)
  /// Rempli quand la voie devient un actif AGEROUTE. L'identifiant source ne devient
  /// JAMAIS un identifiant BDRI : la relation est conservee, l'identite non.
  tronconId String?
  troncon   Troncon?     @relation(fields: [tronconId], references: [id])

  geom Unsupported("geometry(LineString,4326)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, sourceId])
  @@index([categorie])
  @@index([statut])
  @@map("voirie_locale")
}

// ─────────────────────────────────────────────────────────────────────────────
// AGEROUTE ROAD — socle terrain
//
// POURQUOI CES MODELES, ET POURQUOI MAINTENANT
//
// La collecte terrain existe deja, mais sous une forme qui ne porte pas le besoin :
// une Inspection est attachee a UN troncon ou UN ouvrage, saisie dans un formulaire,
// sans notion de deplacement ni de campagne. Le terrain reel est une MISSION — une
// equipe, un vehicule, une zone, un trajet — au cours de laquelle des observations
// tombent la ou elles tombent.
//
// Mesure du 07/10/2026 : aucun de ces concepts n'existe au schema. Mission, Appareil,
// Trace et Observation sont absents des 27 modeles. C'est la premiere brique du
// programme, et tout le reste s'y accroche.
//
// LA LANGUE
//
// Le dossier V2 nomme ces entites en anglais (FieldMission, Track, Observation). Les
// 27 modeles existants sont en francais, sans exception. Un schema a moitie bilingue
// coute plus cher a lire qu'il ne gagne en fidelite a un document : on garde le
// francais, « Observation » se trouvant etre identique dans les deux.
//
// L'IDEMPOTENCE N'EST PAS INVENTEE ICI
//
// Inspection.clientInspectionId porte deja la regle : le client genere un identifiant
// AVANT d'envoyer, le serveur refuse une seconde creation sous le meme. Elle est
// generalisee en clientOperationId, pas remplacee. Sans elle, une reponse perdue en
// chemin — le cas courant sur un reseau guineen — produit un doublon a chaque reessai.
//
// CE QUI N'EST PAS LA
//
// Le modele Asset generique du dossier. Il suppose de faire de Ouvrage une
// specialisation, donc de toucher 1 089 lignes en production et tous les ecrans qui
// les lisent. Ce n'est pas un premier increment, c'est une migration a part entiere.
// Observation.ouvrageId suffit en attendant.
// ─────────────────────────────────────────────────────────────────────────────

enum TypeMission {
  INSPECTION
  INVENTAIRE
  SURVEILLANCE
  CONTROLE_CHANTIER
  RECEPTION
  SECURITE
  URGENCE
  RELEVE_SIG
}

/// Cycle de vie d'une mission. TELECHARGEE et SYNC_EN_ATTENTE ne sont pas decoratifs :
/// ils distinguent « l'agent peut partir » de « l'agent est rentre mais rien n'est
/// encore remonte », deux situations qu'un responsable doit voir differemment.
enum StatutMission {
  BROUILLON
  PLANIFIEE
  TELECHARGEE
  EN_COURS
  SUSPENDUE
  TERMINEE
  SYNC_EN_ATTENTE
  ANNULEE
}

enum TypeObservation {
  DEGRADATION
  CHAUSSEE
  ASSAINISSEMENT
  SIGNALISATION
  OUVRAGE
  SECURITE
  TRAFIC
  ENVIRONNEMENT
  CHANTIER
  INCIDENT
  AUTRE
}

/// Une observation de terrain n'est PAS une donnee officielle tant qu'elle n'a pas ete
/// validee. C'est la regle centrale du dossier V2, et elle prolonge ce que
/// PropositionLocalisation fait deja pour la geometrie des chantiers.
enum StatutObservation {
  BROUILLON
  PROPOSEE
  VALIDEE
  REJETEE
  CONVERTIE
}

enum StatutSync {
  EN_ATTENTE
  EN_COURS
  SYNCHRONISE
  CONFLIT
  REJETE
}

/// Appareil enregistre, pour qu'une session mobile soit revocable sans toucher au
/// compte. Un telephone perdu se revoque ; son porteur garde son acces web.
model Appareil {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  nom        String?
  plateforme String
  modele     String?
  versionOs  String?
  versionApp String?

  dernierVuA DateTime?
  revoqueA   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  missions   Mission[]
  traces     Trace[]
  operations OperationSync[]

  @@index([userId])
  @@index([revoqueA])
  @@map("appareils")
}

model Mission {
  id       String        @id @default(uuid())
  code     String        @unique
  intitule String
  type     TypeMission
  statut   StatutMission @default(BROUILLON)

  createurId String
  createur   User    @relation("MissionCreateur", fields: [createurId], references: [id])
  assigneId  String?
  assigne    User?   @relation("MissionAssigne", fields: [assigneId], references: [id])

  appareilId String?
  appareil   Appareil? @relation(fields: [appareilId], references: [id])

  regionId   Int?
  region     Region?   @relation(fields: [regionId], references: [id])
  chantierId String?
  chantier   Chantier? @relation(fields: [chantierId], references: [id])

  vehicule String?
  equipe   String?

  debutPrevu DateTime?
  finPrevue  DateTime?
  debutReel  DateTime?
  finReelle  DateTime?

  /// Emprise de la mission. PREMIER polygone du schema : tout le reste est en Point ou
  /// LineString. La colonne est posee par la migration, Prisma ne sachant pas
  /// manipuler les types geometriques.
  emprise    Unsupported("geometry(Polygon,4326)")?
  /// Itineraire prevu, distinct des traces reellement parcourues.
  itineraire Unsupported("geometry(LineString,4326)")?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  traces       Trace[]
  observations Observation[]

  defauts Defaut[]

  @@index([statut])
  @@index([assigneId])
  @@index([regionId])
  @@index([deletedAt])
  @@map("missions")
}

/// Un trajet enregistre pendant une mission. Separe de la mission parce qu'une mission
/// peut comporter plusieurs trajets : aller, retour, deviation.
model Trace {
  id        String  @id @default(uuid())
  missionId String
  mission   Mission @relation(fields: [missionId], references: [id])

  userId     String
  user       User      @relation(fields: [userId], references: [id])
  appareilId String?
  appareil   Appareil? @relation(fields: [appareilId], references: [id])

  debutA DateTime
  finA   DateTime?

  distanceKm     Float?
  dureeSec       Int?
  vitesseMoyenne Float?
  vitesseMax     Float?

  geom Unsupported("geometry(LineString,4326)")?

  createdAt DateTime @default(now())

  points PointTrace[]

  @@index([missionId])
  @@index([userId])
  @@map("traces")
}

/// Un point GPS brut, conserve tel que l'appareil l'a rendu, precision comprise : une
/// position a plus ou moins 500 m ne vaut pas une position a 5 m, et le moteur
/// d'appariement doit pouvoir refuser de conclure. Mesure du 07/10/2026 : a 15 m
/// d'erreur en milieu urbain, l'appariement se trompe de rue.
model PointTrace {
  id      String @id @default(uuid())
  traceId String
  trace   Trace  @relation(fields: [traceId], references: [id], onDelete: Cascade)

  horodatage DateTime
  lat        Float
  lon        Float
  altitude   Float?
  vitesse    Float?
  cap        Float?
  precisionM Float?
  satellites Int?
  hdop       Float?

  geom Unsupported("geometry(Point,4326)")?

  @@index([traceId, horodatage])
  @@map("points_trace")
}

model Observation {
  id String @id @default(uuid())

  /// Cle d'idempotence generee par le CLIENT avant tout envoi. Meme regle que
  /// Inspection.clientInspectionId, generalisee : une reponse perdue en chemin ne doit
  /// pas produire un doublon au reessai.
  clientOperationId String @unique

  missionId String?
  mission   Mission? @relation(fields: [missionId], references: [id])

  agentId String
  agent   User   @relation("ObservationAgent", fields: [agentId], references: [id])

  type        TypeObservation
  statut      StatutObservation @default(PROPOSEE)
  gravite     Gravite?
  description String?

  /// Rattachements, tous facultatifs : une observation peut tomber la ou aucun objet
  /// n'est encore inventorie, et c'est precisement ce qu'on veut savoir.
  tronconId  String?
  troncon    Troncon?  @relation(fields: [tronconId], references: [id])
  ouvrageId  String?
  ouvrage    Ouvrage?  @relation(fields: [ouvrageId], references: [id])
  chantierId String?
  chantier   Chantier? @relation(fields: [chantierId], references: [id])

  /// PK apparie. Nul tant que le moteur ne sait pas conclure — mesure du 07/10/2026 :
  /// seuls 551 des 1 691 troncons du reseau classe portent des PK exploitables.
  pk Float?

  lat        Float?
  lon        Float?
  precisionM Float?
  geom       Unsupported("geometry(Point,4326)")?

  /// Confiance de l'appariement, entre 0 et 1. Distincte de la gravite : l'une dit ce
  /// qu'on a vu, l'autre a quel point on sait ou.
  confianceAppariement Float?

  observeA     DateTime
  valideeA     DateTime?
  validateurId String?
  validateur   User?     @relation("ObservationValidateur", fields: [validateurId], references: [id])
  motifRejet   String?

  /// Version pour la detection de conflit a la synchronisation. Une modification partie
  /// d'une version perimee ne doit jamais ecraser en silence.
  version Int @default(1)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  medias MediaObservation[]

  defauts  Defaut[]
  portions Portion[]

  @@index([missionId])
  @@index([tronconId])
  @@index([statut])
  @@index([deletedAt])
  @@map("observations")
}

/// Photo, video ou audio rattache a une observation. sha256 est unique : le meme
/// fichier renvoye deux fois apres une coupure ne cree pas deux lignes.
model MediaObservation {
  id            String      @id @default(uuid())
  observationId String
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  type           String
  chemin         String
  cheminVignette String?
  sha256         String  @unique
  mimeType       String
  tailleOctets   Int

  lat        Float?
  lon        Float?
  precisionM Float?
  cap        Float?
  capturedA  DateTime?

  createdAt DateTime @default(now())

  @@index([observationId])
  @@map("medias_observation")
}

/// Une operation en attente de synchronisation, telle que l'appareil l'a produite.
/// operationId est unique : rejouer la meme operation ne la rejoue pas.
model OperationSync {
  id          String @id @default(uuid())
  operationId String @unique

  appareilId String
  appareil   Appareil @relation(fields: [appareilId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  entityType String
  entityId   String
  operation  String

  payload     Json
  baseVersion Int?

  statut         StatutSync @default(EN_ATTENTE)
  tentatives     Int        @default(0)
  derniereErreur String?

  createdAt DateTime  @default(now())
  traiteeA  DateTime?

  @@index([appareilId, statut])
  @@index([entityType, entityId])
  @@map("operations_sync")
}

/// Un conflit non resolu. Il n'est JAMAIS tranche automatiquement sur une donnee
/// patrimoniale : les deux versions sont conservees et un responsable decide.
model ConflitSync {
  id          String @id @default(uuid())
  operationId String

  entityType String
  entityId   String

  payloadLocal   Json
  payloadServeur Json

  resolution  String?
  resoluParId String?
  resoluA     DateTime?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@map("conflits_sync")
}

// ===================== GOUVERNANCE (validation et perimetre) =====================

/// Etat de validation d'un objet du patrimoine.
///
/// Observation ou import n'est pas donnee officielle. Cette regle valait d'abord pour
/// les observations de terrain ; elle est generalisee a tout objet du geoportail.
///
/// UN SEUL ETAT D'ATTENTE. Un objet importe attend la meme decision, du meme type de
/// personne, avec les memes consequences qu'un defaut releve sur le terrain. Garder
/// deux noms obligerait chaque requete a ecrire une liste, et un oubli quelque part
/// laisserait passer pour officiel ce qui ne l'est pas. L'origine est une information,
/// elle va dans `Validation.source`.
enum StatutValidation {
  A_VALIDER
  VALIDE
  REJETE
  A_CORRIGER
}

/// Perimetre statistique : un objet compte-t-il dans les chiffres nationaux publies.
///
/// TROIS RESEAUX QUI NE SE CONFONDENT PAS. Le fond cartographique charge peut contenir
/// des troncons hors Guinee, et il le doit : sans eux la carte s'arrete net a la
/// frontiere. Le reseau national publie ne compte que ce qui est guineen.
///
/// Ce que ce champ remplace : l'exclusion reposait sur un PREFIXE dans
/// `sourceReference` (`hors_territoire:`, `voirie_locale:`). Un prefixe de chaine n'est
/// pas un statut — il ne porte ni pays, ni motif, ni date, ni validateur, et une faute
/// de frappe le rend muet sans que rien ne le signale.
enum PerimetreReseau {
  NATIONAL
  HORS_TERRITOIRE_NATIONAL
  VOIRIE_LOCALE
}

/// Decisions de validation, conservees en HISTORIQUE et non comme un etat courant.
///
/// POURQUOI UNE TABLE ET NON SEULEMENT DES COLONNES
///
/// Un objet peut etre renvoye en correction puis represente plusieurs fois. Des colonnes
/// `validePar` et `valideA` ne retiennent que la DERNIERE decision : la chaine qui dit
/// comment une donnee est devenue officielle disparait, et c'est precisement ce qu'un
/// audit demande a voir.
///
/// La table est polymorphe (`entityType` + `entityId`), comme `audit_logs` et
/// `valeurs_qualite` qui suivent deja ce motif ici. Chaque entite porte en plus une
/// colonne `statutValidation` denormalisee, pour pouvoir filtrer et indexer sans
/// jointure ; les deux s'ecrivent dans la meme transaction.
model Validation {
  id String @id @default(uuid())

  entityType String
  entityId   String

  /// Etat avant la decision. Nul pour la premiere entree d'un objet importe, qui
  /// n'avait aucun statut auparavant.
  statutAvant StatutValidation?
  statutApres StatutValidation

  decidePar   User?    @relation("ValidationDecideur", fields: [decideParId], references: [id])
  decideParId String?
  decideA     DateTime @default(now())

  /// Qui ou quoi a produit l'objet valide. Une personne, ou un document : les 81
  /// ouvrages DTOAA viennent d'un PDF et non d'un agent.
  auteurId String?
  source   String?

  /// Motif obligatoire pour un rejet ou une demande de correction. Un refus sans raison
  /// est un refus qu'on ne peut pas corriger.
  commentaire String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([statutApres])
  @@index([decideParId])
  @@map("validations")
}

// ===================== DEFAUTS (catalogue et constats) =====================

/// Unite du metre. Portee par le CATALOGUE et non par l'agent : si chacun choisit, deux
/// releves du meme nid-de-poule arrivent l'un en unites et l'autre en metres carres, et
/// leur somme ne veut rien dire.
enum UniteDefaut {
  UNITE
  METRE
  METRE_CARRE
  METRE_CUBE
}

/// Mesures qu'un catalogue peut exiger d'un releve.
///
/// Cette liste est DISTINCTE de l'unite du metre. Un ornierage exige une profondeur sans
/// que celle-ci entre dans son metre, qui reste lineaire : la profondeur qualifie la
/// gravite. Confondre les deux listes produirait des volumes la ou on veut des metres.
enum MesureDefaut {
  NOMBRE
  LONGUEUR
  LARGEUR
  PROFONDEUR
  QUANTITE
}

/// Famille de rattachement, qui dit quel metier traite le defaut.
enum FamilleDefaut {
  CHAUSSEE
  ACCOTEMENT
  ASSAINISSEMENT
  OUVRAGE
  SIGNALISATION
  SECURITE
  ENVIRONNEMENT
}

/// Par quelle voie la quantite a ete obtenue. Conservee parce qu'un chiffre qui servira
/// a chiffrer un marche doit dire s'il a ete mesure ou calcule.
enum MethodeQuantite {
  SAISIE
  COMPTAGE
  LONGUEUR
  LONGUEUR_LARGEUR
  LONGUEUR_LARGEUR_PROFONDEUR
}

/// Importance spatiale du defaut sur le troncon, independante de sa gravite.
///
/// « Faiencage, gravite forte, etendue generalisee, 2 850 m2 » se traite ; « defaut
/// important » ne se traite pas. Une gravite forte sur trois metres carres et la meme
/// gravite sur trois mille ne demandent ni le meme chantier ni le meme budget.
///
/// POURQUOI UNE ECHELLE QUALITATIVE ET NON UN TAUX D'OCCUPATION. Un taux serait plus
/// exploitable, mais il n'est pas calculable : `Troncon` ne porte que `longueurKm`,
/// aucune largeur ni nombre de voies. La surface d'un troncon est donc inconnue sur la
/// totalite du reseau, et un taux calcule dessus serait une invention.
enum EtendueDefaut {
  PONCTUEL
  LOCALISE
  ETENDU
  GENERALISE
}

/// Existence physique du defaut, distincte de sa validation administrative.
///
/// DISPARU n'est pas TRAITE : un ravinement comble par une crue a disparu sans qu'on ait
/// depense un franc, et confondre les deux fausserait le suivi des travaux realises.
enum EtatDefaut {
  ACTIF
  TRAITE
  DISPARU
}

/// Catalogue des types de defauts : le vocabulaire commun sans lequel rien ne se somme.
///
/// CE QU'IL REMPLACE
///
/// `Inspection.defautsConstates` est un champ texte. Un inspecteur y ecrit « nids de
/// poule importants sur 2 km ». Cette phrase est lisible par un humain et inexploitable
/// par tout le reste : on n'en tire ni surface, ni cout, ni priorite.
///
/// IL EST ADMINISTRABLE, PAS CODE DANS L'APPLICATION
///
/// Les types, leurs unites et leurs mesures obligatoires evoluent avec le referentiel
/// metier. Les coder en dur obligerait a livrer une version du logiciel a chaque
/// evolution.
///
/// CE QU'IL NE PORTE PAS
///
/// Les SEUILS de gravite, qui sont normatifs. « A partir de quelle profondeur une
/// orniere est grave » se tranche dans un catalogue officiel, pas ici. `seuils` reste
/// donc nul et VISIBLE : son absence dit que la gravite saisie est un jugement.
model CatalogueDefaut {
  id      Int           @id @default(autoincrement())
  code    String        @unique
  libelle String
  famille FamilleDefaut

  /// Sous-type, quand le referentiel en distingue. Une hierarchie plutot qu'un champ
  /// libre : un sous-type ecrit a la main ne se regroupe pas.
  parentId  Int?
  parent    CatalogueDefaut?  @relation("SousTypeDefaut", fields: [parentId], references: [id])
  sousTypes CatalogueDefaut[] @relation("SousTypeDefaut")

  /// Unite dans laquelle le metre s'exprime.
  unite UniteDefaut

  /// Mesures sans lesquelles le releve est incomplet. Le moteur refuse alors le defaut
  /// en NOMMANT ce qui manque, pendant que l'agent est encore sur place : c'est la seule
  /// fenetre ou la correction coute une minute plutot qu'un deplacement.
  mesuresRequises MesureDefaut[]

  /// Nombre de crans de gravite. NUL pour les types qui ne se graduent pas : un panneau
  /// manquant est absent ou present, le graduer remplirait un champ sans rien mesurer.
  graviteMax Int? @default(4)

  /// Seuils normatifs par cran, vides tant qu'aucun referentiel officiel n'est adopte.
  seuils Json?

  description String?

  /// D'ou vient cette entree. La valeur par defaut dit franchement que le vocabulaire
  /// est courant et non normatif, pour qu'on ne le prenne pas pour un arrete.
  source String @default("vocabulaire_courant_a_valider")

  version Int     @default(1)
  actif   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  defauts Defaut[]

  @@index([famille])
  @@index([actif])
  @@index([parentId])
  @@map("catalogue_defauts")
}

/// Un defaut constate : le premier objet de la chaine dont un cout pourra dependre.
///
/// LE PK N'EST PAS UNE DEPENDANCE STRUCTURELLE
///
/// Un defaut est d'abord un objet geospatial : un point GPS, un troncon apparie, une
/// abscisse locale sur ce troncon. Le PK de route est DERIVE, affiche quand une
/// calibration existe, absent sinon, et il ne bloque ni la creation, ni le metre, ni la
/// validation.
///
/// Ce n'est pas une precaution theorique. Mesure du 07/10/2026 : 552 des 1 691 troncons
/// du reseau classe portent des PK exploitables, et les 1 029 regionales n'ont meme pas
/// de structure de route a laquelle rapporter un PK (docs/rai-v3/08). Exiger un PK
/// rendrait le terrain impossible sur les deux tiers du reseau.
model Defaut {
  id String @id @default(uuid())

  /// Reference lisible, pour se citer par radio ou dans un courrier.
  code String? @unique

  /// Cle d'idempotence generee par le CLIENT avant tout envoi, quand le defaut remonte
  /// du terrain. Nulle pour un defaut saisi au bureau.
  clientOperationId String? @unique

  catalogueId Int
  catalogue   CatalogueDefaut @relation(fields: [catalogueId], references: [id])

  /// Observation d'origine. OBLIGATOIRE : le paragraphe 7.1 du cahier RAI V3.1 la marque
  /// « Oui », et c'est par elle qu'un defaut remonte jusqu'a la photo, au point GPS et a
  /// l'agent qui l'a releve. Un defaut sans observation serait un constat sans constatant.
  ///
  /// `missionId` reste en revanche FACULTATIF, et ce n'est pas une negligence :
  /// `observations.missionId` est lui-meme nullable. L'exiger ici rendrait le defaut plus
  /// strict que l'observation dont il derive, et interdirait tout defaut issu d'une
  /// observation hors mission — cas que le schema autorise explicitement.
  observationId String
  observation   Observation @relation(fields: [observationId], references: [id])

  missionId String?
  mission   Mission? @relation(fields: [missionId], references: [id])

  tronconId String?
  troncon   Troncon? @relation(fields: [tronconId], references: [id])
  ouvrageId String?
  ouvrage   Ouvrage? @relation(fields: [ouvrageId], references: [id])

  /// LOCALISATION. Le GPS et l'abscisse locale sont la reference primaire.
  lat        Float?
  lon        Float?
  precisionM Float?
  geom       Unsupported("geometry(Point,4326)")?

  /// Abscisse depuis le debut du SEGMENT, en metres. Ce n'est PAS un PK et ne doit
  /// jamais etre presentee comme tel : elle ne vaut que sur un segment identifie.
  abscisseM Float?

  /// Confiance de l'appariement, entre 0 et 1. Distincte de la gravite : l'une dit a
  /// quel point on sait ou, l'autre ce qu'on a vu.
  confianceAppariement Float?

  /// PK de route, derive. Nul quand le troncon n'en porte pas.
  pk Float?

  /// Emprise relevee, quand le defaut a ete contourne au GPS plutot que pointe.
  /// Deliberement `geometry` et non `Polygon` : un defaut lineaire se releve en
  /// LineString, un defaut surfacique en Polygon, et imposer l'un des deux obligerait a
  /// migrer la colonne le jour ou l'autre se presente.
  emprise Unsupported("geometry(Geometry,4326)")?

  /// MESURES BRUTES, conservees meme quand la quantite est calculee.
  ///
  /// Une surface de 12 m2 dont on a perdu le 4 par 3 ne se verifie plus et ne se
  /// corrige plus. On garde les facteurs pour pouvoir rejouer le calcul.
  nombre         Int?
  longueurM      Float?
  largeurM       Float?
  profondeurM    Float?
  quantiteSaisie Float?

  /// QUANTITE EXPLOITABLE, avec son unite et sa voie d'obtention.
  ///
  /// Nulle quand les mesures ne permettent pas de conclure. Zero serait pire : zero se
  /// somme, s'affiche, et dirait « pas de degradation » la ou on veut dire « on ne sait
  /// pas ».
  quantite        Float?
  uniteQuantite   UniteDefaut?
  methodeQuantite MethodeQuantite?

  /// Jugement de l'agent, borne par `CatalogueDefaut.graviteMax`. Jamais une mesure.
  gravite Int?

  /// Etendue spatiale, axe distinct de la gravite.
  etendue EtendueDefaut?

  etat EtatDefaut @default(ACTIF)

  /// Tout defaut nait en attente d'une decision : il est une PROPOSITION. Le defaut de
  /// colonne porte donc la regle, et non la bonne volonte de l'appelant.
  statutValidation StatutValidation @default(A_VALIDER)

  description String?

  constateA     DateTime
  constateParId String
  constatePar   User     @relation("DefautConstatant", fields: [constateParId], references: [id])

  /// Date de passage a TRAITE. Distincte de `updatedAt` : on veut savoir quand les
  /// travaux ont eu lieu, pas quand la ligne a ete touchee.
  traiteA DateTime?

  /// Version pour la detection de conflit a la synchronisation.
  version Int @default(1)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  medias MediaDefaut[]

  @@index([catalogueId])
  @@index([tronconId])
  @@index([ouvrageId])
  @@index([observationId])
  @@index([missionId])
  @@index([statutValidation])
  @@index([etat])
  @@index([deletedAt])
  @@map("defauts")
}

/// Preuve attachee a un defaut : photo, video, document.
///
/// Table distincte de `medias_observation` plutot qu'une colonne nullable ajoutee a
/// celle-ci : les deux rattachements resteraient alors facultatifs et une ligne pourrait
/// n'etre attachee a rien. Le cout est une structure proche ; le gain est une contrainte
/// qui tient.
model MediaDefaut {
  id       String @id @default(uuid())
  defautId String
  defaut   Defaut @relation(fields: [defautId], references: [id], onDelete: Cascade)

  type           String
  chemin         String
  cheminVignette String?
  sha256         String  @unique
  mimeType       String
  tailleOctets   Int

  /// Position et cap du cliche. Une photo de preuve sans coordonnees ne prouve pas ou
  /// elle a ete prise.
  lat        Float?
  lon        Float?
  precisionM Float?
  cap        Float?
  capturedA  DateTime?

  createdAt DateTime @default(now())

  @@index([defautId])
  @@map("medias_defaut")
}

// ===================== DELEGATION DE VALIDATION =====================

/// Domaines sur lesquels un validateur peut etre designe.
///
/// Paragraphe 35 du cahier : « Un validateur est designe pour chaque domaine. » Alignes
/// sur `ENTITES_VALIDABLES` de `governance/validation.ts` — un domaine qui n'y figurerait
/// pas designerait un validateur pour quelque chose qui ne se valide pas.
enum DomaineValidation {
  TRONCON
  OUVRAGE
  DEFAUT
  OBSERVATION
  POINT_NOIR
  POSTE
  CHANTIER
  /// Ajoute le 13/10/2026 avec l'ecriture des portions. `ALTER TYPE ADD VALUE`
  /// est DEFINITIF : PostgreSQL ne sait pas retirer une valeur d'enum.
  PORTION
}

/// Designation d'un validateur sur un domaine, eventuellement borne a une region et a une
/// periode.
///
/// CE QU'ELLE REMPLACE
///
/// `ROLES_VALIDATEURS` admet ADMIN et GESTIONNAIRE : tout gestionnaire pouvait donc
/// valider n'importe quel defaut, n'importe quelle observation, partout dans le pays. Il
/// n'y avait ni domaine, ni perimetre, ni terme, ni delegant. La « validation selon
/// delegation » du paragraphe 5 n'avait aucun equivalent dans le code.
///
/// RIEN N'EST SUPPRIME, JAMAIS
///
/// Une delegation expiree ou revoquee reste en base. Elle a existe, des validations ont
/// ete rendues sous son autorite, et les retirer rendrait ces validations inexplicables.
/// `revoqueeLe` est donc une date et non une suppression — regle 2 d'AGENTS.md appliquee
/// a un objet de gouvernance.
///
/// AUCUNE CONTRAINTE D'UNICITE, VOLONTAIREMENT
///
/// Une meme personne peut etre designee plusieurs fois sur un domaine : une region puis
/// une autre, ou une periode puis la suivante. Une cle unique sur (domaine, validateur)
/// interdirait l'historique que ce modele existe pour conserver.
model DelegationValidation {
  id String @id @default(uuid())

  domaine DomaineValidation

  validateurId String
  validateur   User   @relation("DelegationValidateur", fields: [validateurId], references: [id])

  /// Perimetre geographique. NUL = national, c'est-a-dire toutes les regions.
  ///
  /// Consequence a connaitre : une delegation REGIONALE ne couvre pas un objet dont la
  /// region est inconnue — un defaut dont le troncon n'est pas apparie, par exemple.
  /// L'accepter reviendrait a deduire une localisation de l'absence de localisation.
  regionId Int?
  region   Region? @relation(fields: [regionId], references: [id])

  /// Qui delegue. Le paragraphe 35 designe un validateur ; savoir QUI l'a designe est ce
  /// qui distingue une delegation d'une permission tombee du ciel.
  delegueParId String
  deleguePar   User   @relation("DelegationDelegant", fields: [delegueParId], references: [id])

  debutLe DateTime  @default(now())
  /// Terme. NUL = sans terme. Une delegation sans terme est un choix, pas un oubli.
  finLe   DateTime?

  revoqueeLe    DateTime?
  revoqueeParId String?
  revoqueePar   User?     @relation("DelegationRevocateur", fields: [revoqueeParId], references: [id])

  /// Pourquoi cette designation. Lu lors d'un audit, des annees apres.
  motif String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([domaine])
  @@index([validateurId])
  @@index([regionId])
  @@map("delegations_validation")
}

// ===================== CONDITION ENGINE / RCI =====================

/// Composantes du RCI, dans l'ordre du paragraphe 13 du cahier.
enum ComposanteRci {
  CHAUSSEE
  DRAINAGE
  OUVRAGES
  SIGNALISATION
  SECURITE
  TRAFIC
  HISTORIQUE
  INCIDENTS
  /// Ajoutees le 13/10/2026 pour pouvoir EXPRIMER la liste de coefficients proposee par
  /// AGEROUTE, qui remplace les 10 points de SIGNALISATION par environnement 5 et autres 5.
  ///
  /// Les ajouter ne les approuve pas : elles rendent la proposition enregistrable et donc
  /// comparable, ce qui etait la demande. `ALTER TYPE ADD VALUE` est definitif.
  ///
  /// AUTRES est structurellement particuliere : une composante sans definition ne peut
  /// JAMAIS etre alimentee, donc son poids est renormalise hors du calcul a chaque score.
  /// Tant qu'elle n'est pas definie, ses 5 points sont du poids mort.
  ENVIRONNEMENT
  AUTRES
}

/// Pourquoi une composante ne participe pas a un score.
///
/// PERIMEE et ABSENTE ne se confondent pas : un etat releve il y a dix ans demande une
/// REINSPECTION, un etat jamais releve demande un INVENTAIRE. Les deux sortent du calcul,
/// mais on ne va pas chercher la meme chose.
enum MotifExclusionRci {
  ABSENTE
  PERIMEE
  CONFIANCE_INSUFFISANTE
  POIDS_NUL
}

/// Une version de regle de calcul du RCI.
///
/// POURQUOI LES COEFFICIENTS SONT EN BASE ET NON DANS LE CODE
///
/// Le paragraphe 13 donne ses pourcentages comme « base indicative A CALIBRER ». Les
/// ecrire dans le code produirait un score qui a l'air officiel et que personne n'a
/// valide — ce que la regle imperative du paragraphe 39 interdit.
///
/// `approuveeLe` est donc le seul interrupteur qui rend un score publiable. Tant qu'il est
/// nul, le moteur calcule, l'interne consulte, et rien ne sort.
///
/// UNE REGLE EST IMMUABLE
///
/// Modifier des coefficients cree une NOUVELLE version. Sans quoi un score rendu l'annee
/// derniere deviendrait inexplicable : sa regle aurait change sous lui.
model RegleCondition {
  id      String @id @default(uuid())
  /// Identifiant lisible, inscrit dans chaque score. Ex. « rci-2026.1 ».
  version String @unique

  /// Poids par composante. Leur somme n'a pas besoin de valoir 100 : le moteur
  /// renormalise sur les composantes effectivement disponibles.
  poids Json

  /// Age maximal d'un constat, en jours. Au-dela, la composante est PERIMEE.
  fraicheurMaxJours Int

  /// Confiances acceptees, vocabulaire de `valeurs_qualite`. Une confiance absente est
  /// traitee comme insuffisante : on ne la suppose pas bonne.
  confiancesAcceptees String[]

  /// Part minimale du poids total a couvrir pour qu'un score soit rendu (0 a 1).
  ///
  /// Renormaliser sur 20 % du modele produirait un nombre entre 0 et 100 qui ne dit
  /// presque rien. C'est AGEROUTE qui dit a partir de quelle part un score merite d'etre
  /// regarde.
  couvertureMinimale Float

  /// `true` si 100 est le meilleur etat. Explicite, pour que le sens ne se perde pas.
  sensCroissant Boolean @default(true)

  /// Correspondance entre une valeur de source et un nombre de 0 a 100.
  ///
  /// POURQUOI ELLE VIT ICI ET NON DANS LE CODE
  ///
  /// Le moteur refuse de deviner comment un etat BON devient un nombre : c'est une
  /// DECISION, pas un calcul. Dire que BON vaut 85 plutot que 90 deplace le score de tout
  /// le reseau, et personne ne pourrait dire qui l'a decide si c'etait ecrit en dur.
  ///
  /// Elle vit donc dans la REGLE VERSIONNEE, au meme titre que les poids, et une regle
  /// non approuvee produit des scores marques non publiables. Le mecanisme est du code ;
  /// les nombres sont une decision d'AGEROUTE.
  ///
  /// FORME : { "<COMPOSANTE>": { "<valeur source>": <0-100> } }. Une valeur de source
  /// absente de la table rend la composante ABSENTE, jamais zero : on ne sait pas la lire,
  /// ce qui n'est pas la meme chose que savoir qu'elle est mauvaise.
  normalisation Json @default("{}")

  /// Pourquoi cette version existe, et sur quoi elle a ete calibree.
  motif String?

  creeParId String
  creePar   User   @relation("RegleConditionAuteur", fields: [creeParId], references: [id])

  /// NUL = non approuvee. Les scores rendus sous cette regle ne sont pas publiables.
  approuveeLe    DateTime?
  approuveeParId String?
  approuveePar   User?     @relation("RegleConditionApprobateur", fields: [approuveeParId], references: [id])

  /// Retrait d'usage. La regle reste en base : des scores y font reference.
  retireeLe DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluations EvaluationCondition[]

  @@index([approuveeLe])
  @@map("regles_condition")
}

/// Un score RCI rendu a un instant, sous une version de regle.
///
/// IMMUABLE : recalculer cree une nouvelle evaluation. Un score qu'on modifierait ne
/// pourrait plus etre explique, et la comparaison dans le temps perdrait son sens.
model EvaluationCondition {
  id String @id @default(uuid())

  tronconId String
  troncon   Troncon @relation(fields: [tronconId], references: [id])

  regleId      String
  regle        RegleCondition @relation(fields: [regleId], references: [id])
  /// Version recopiee, pour que l'evaluation reste lisible meme si la regle est retiree.
  regleVersion String

  /// NUL quand le moteur a REFUSE de scorer. Le refus est conserve : il dit qu'on a
  /// regarde et qu'on n'a pas pu conclure, ce qui n'est pas la meme chose que l'absence
  /// d'evaluation.
  score      Float?
  /// Motif du refus, quand il y en a un.
  motifRefus String?

  /// Part du poids total couverte, entre 0 et 1.
  couverture Float

  /// NULLE sur un refus. La confiance d'un score qui n'existe pas n'est pas « faible » :
  /// elle est absente. Ecrire LOW serait porter un jugement de qualite sur rien.
  confiance NiveauConfiance?

  /// `false` quand la regle n'etait pas approuvee au moment du calcul.
  publiable Boolean @default(false)

  /// La phrase qui explique le score, telle que le moteur l'a rendue.
  explication String

  /// Instantane des entrees, pour pouvoir rejouer le calcul apres evolution des sources.
  /// Sans lui, un score de 2026 serait inexplicable en 2029.
  entrees Json

  calculeLe DateTime @default(now())

  composantes ComposanteEvaluation[]

  @@index([tronconId, calculeLe])
  @@index([regleId])
  @@index([publiable])
  @@map("evaluations_condition")
}

/// Une composante d'un score, retenue ou exclue.
///
/// Les lignes sont requetables — « combien de troncons manquent de donnee de trafic » est
/// une question qu'on posera — la ou l'instantane de `EvaluationCondition` sert a rejouer
/// le calcul. Les deux repondent a des besoins differents.
model ComposanteEvaluation {
  id String @id @default(uuid())

  evaluationId String
  evaluation   EvaluationCondition @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  composante ComposanteRci

  /// Valeur normalisee 0-100 retenue. NULLE pour une composante exclue.
  valeur Float?

  poidsDeclare  Float
  /// Poids APRES renormalisation. Sans lui, le calcul ne se refait pas.
  poidsEffectif Float
  contribution  Float

  /// NUL quand la composante a ete retenue.
  exclue MotifExclusionRci?

  source     String?
  observeeLe DateTime?

  /// Une composante figure UNE fois par evaluation : deux lignes compteraient son poids
  /// deux fois. L'index couvre aussi les recherches par evaluation seule.
  @@unique([evaluationId, composante])
  @@index([composante, exclue])
  @@map("composantes_evaluation")
}

// ===================== PORTIONS HOMOGENES =====================

/// D'ou vient une portion. Sans cela, un decoupage et un releve de terrain se
/// ressemblent en base, et l'historique devient illisible.
enum OriginePortion {
  /// Qualifiee par un agent sur place.
  SAISIE_TERRAIN
  /// Nee du decoupage d'une portion existante.
  DECOUPE
  /// Nee de la fusion de portions compatibles.
  FUSION
  /// Meme emprise, attributs revus.
  REQUALIFICATION
  /// Venue d'un lot externe. Jamais officielle sans validation.
  IMPORT
}

/// Une partie homogene d'un troncon.
///
/// LE PROBLEME QU'ELLE RESOUT
///
/// Un troncon porte UN revetement et UN etat pour toute sa longueur. Le terrain ne s'y
/// plie pas : 8 km de bitume en bon etat, 5 km de bitume degrade, 4 km de laterite, 3 km
/// critiques, et c'est le meme troncon.
///
/// L'ABSCISSE LOCALE FAIT AUTORITE, PAS LE PK, ET PAS LA GEOMETRIE
///
/// `debutM` et `finM` sont mesures depuis le debut de la geometrie de reference, ce que
/// `ST_LineLocatePoint` rend et que `geo/appariement.ts` produit deja. Le PK officiel
/// n'est pas porte ici : les 1 029 troncons regionaux n'en ont pas de calculable, et
/// faire dependre la qualification du PK les aurait rendus inqualifiables.
///
/// POURQUOI AUCUNE PORTION N'EST DEDUITE D'UN TRONCON
///
/// Mesure du 13/10/2026 en production : `revetement` vaut NON_RENSEIGNE sur 258 961
/// troncons et BITUME sur 2 426, sans une seule laterite sur un reseau ou elle domine ;
/// `etat` vaut NON_EVALUE sur 254 547 des 261 387. Deduire une portion de ces colonnes
/// fabriquerait 261 387 observations que personne n'a faites.
///
/// Un troncon sans portion est donc NON QUALIFIE. `reseau/portions.ts` le rend comme un
/// trou nomme par ses abscisses, pas comme un pourcentage.
///
/// CETTE TABLE NE TOUCHE JAMAIS LA GEOMETRIE DE REFERENCE
///
/// Qualifier le terrain et corriger un trace sont deux operations distinctes, aux droits
/// distincts. Une portion ne produit que des bornes le long d'une geometrie existante.
model Portion {
  id String @id @default(uuid())

  tronconId String
  troncon   Troncon @relation(fields: [tronconId], references: [id])

  /// Abscisse de debut, en metres depuis le debut de la geometrie de reference.
  debutM Float
  /// Abscisse de fin. Toujours strictement superieure a `debutM`.
  finM   Float

  /// NULS tant que personne ne les a releves. Une portion peut qualifier l'etat sans
  /// connaitre le revetement, et l'inverse.
  /// CODES DE REFERENTIEL et non enums : le vocabulaire est administrable, et la cle
  /// etrangere empeche d'ecrire un code que personne n'a declare.
  ///
  /// `troncons.revetement` reste un enum, lui : 261 387 lignes en dependent, et les deux
  /// migrations ne se ressemblent pas. `portions` est vide, donc son changement de type
  /// ne coute rien.
  revetement    String?
  revetementRef ReferentielRevetement?   @relation(fields: [revetement], references: [code])
  etat          String?
  etatRef       ReferentielEtatChaussee? @relation(fields: [etat], references: [code])

  /// Praticabilite, distincte du revetement ET de l'etat : une piste en laterite peut
  /// etre en bon etat et devenir impraticable apres les pluies.
  ///
  /// TEXTE ET NON ENUM, VOLONTAIREMENT. Le cahier demande un referentiel configurable et
  /// n'en enonce aucune valeur, contrairement au revetement dont il liste les huit. Figer
  /// ici un vocabulaire que personne n'a arrete en ferait une norme. La colonne recevra
  /// sa contrainte en meme temps que son referentiel.
  praticabilite    String?
  praticabiliteRef ReferentielPraticabilite? @relation(fields: [praticabilite], references: [code])

  largeurM Float?

  /// D'ou vient l'observation, et quand elle a ete CONSTATEE (pas saisie). Nulles quand
  /// personne ne l'a dit : une date absente n'est pas une date ancienne.
  source     String?
  observeeLe DateTime?
  confiance  NiveauConfiance?

  origine OriginePortion

  /// Cle d'idempotence generee par l'APPAREIL avant tout envoi, comme pour les
  /// observations et les defauts. Sans elle, une reponse perdue en zone blanche fait
  /// renvoyer l'operation et cree une portion en double sur la meme emprise.
  ///
  /// Optionnelle : une portion creee depuis la console n'en a pas besoin.
  clientOperationId String? @unique

  /// Conteneur de collecte, quand la portion vient d'une mission de terrain.
  observationId String?
  observation   Observation? @relation(fields: [observationId], references: [id])

  /// Une portion de terrain est une PROPOSITION jusqu'a validation par un tiers.
  statutValidation StatutValidation @default(A_VALIDER)

  /// Date a laquelle cette version a ete remplacee par un decoupage, une fusion ou une
  /// requalification. NULLE si elle est courante.
  ///
  /// DISTINCT DE `deletedAt`, et la distinction porte : `remplaceeLe` dit « ceci etait
  /// vrai et ne l'est plus », `deletedAt` dit « ceci n'aurait jamais du etre saisi ». Les
  /// confondre rendrait l'historique du reseau inexplicable.
  remplaceeLe DateTime?

  /// Suppression logique seulement (regle 2 d'AGENTS.md). Le patrimoine routier est une
  /// donnee d'archive.
  deletedAt DateTime?

  creeParId String
  creePar   User   @relation("PortionAuteur", fields: [creeParId], references: [id])

  /// Geometrie DERIVEE de `debutM`/`finM` par `ST_LineSubstring`, conservee pour que la
  /// carte n'ait pas a la recalculer sur 261 387 troncons.
  ///
  /// ELLE NE FAIT PAS AUTORITE. Si le trace de reference est corrige, elle devient
  /// perimee et doit etre recalculee depuis les abscisses, jamais l'inverse.
  geom Unsupported("geometry(LineString,4326)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Lignage : d'ou vient cette portion, et ce qu'elle a produit.
  parents PortionLignage[] @relation("LignageEnfant")
  enfants PortionLignage[] @relation("LignageParent")

  @@index([tronconId, debutM])
  @@index([tronconId, remplaceeLe])
  @@index([statutValidation])
  @@index([deletedAt])
  @@index([observationId])
  @@map("portions")
}

/// Lignage entre portions : quelle portion est nee de quelle autre.
///
/// POURQUOI UNE TABLE ET NON UNE COLONNE
///
/// Un decoupage donne UN parent et DEUX enfants ; une fusion donne DEUX parents et UN
/// enfant. Une colonne `remplaceeParId` ne sait exprimer ni l'un ni l'autre sans mentir
/// sur le second. Le lien est donc plusieurs-a-plusieurs, et c'est la seule forme qui
/// permette de relire un decoupage suivi d'une fusion.
model PortionLignage {
  parentId String
  parent   Portion @relation("LignageParent", fields: [parentId], references: [id])
  enfantId String
  enfant   Portion @relation("LignageEnfant", fields: [enfantId], references: [id])

  createdAt DateTime @default(now())

  @@id([parentId, enfantId])
  @@index([enfantId])
  @@map("portions_lignage")
}

// ===================== REFERENTIELS CONFIGURABLES =====================
//
// POURQUOI DES TABLES ET NON DES ENUMS
//
// `Revetement` est un enum de cinq valeurs. L'etendre demande une migration, donc un
// deploiement, pour ajouter un mot. Le cahier en demande huit, et surtout il demande que
// la liste soit ADMINISTRABLE : les trois revetements que `BITUME` recouvre aujourd'hui
// (beton bitumineux, enduit superficiel, beton) n'ont pas les memes couts de
// rehabilitation, et c'est AGEROUTE qui decide du vocabulaire.
//
// POURQUOI TROIS TABLES ET NON UNE TABLE GENERIQUE
//
// Une table unique avec une colonne `domaine` aurait une cle primaire composite
// `(domaine, code)`, et une cle etrangere depuis `portions` ne pourrait pas garantir que
// le code pointe sur le BON domaine sans colonne generee ni declencheur. Trois tables
// donnent trois cles etrangeres triviales et verifiees par la base.
//
// Et surtout, les trois ne portent pas les memes attributs : un revetement est bitumineux
// ou non, un etat est critique ou non, une praticabilite est franchissable ou non. Une
// table generique les aurait tous ranges dans un JSON que personne ne peut contraindre.
//
// POURQUOI TROIS ET PAS LES SEPT DU CAHIER
//
// Le cahier demande aussi des referentiels pour les accotements, l'assainissement, la
// signalisation et les risques de securite. Rien ne les consomme aujourd'hui : les creer
// produirait quatre tables vides que rien ne lit, ce qui est le meme defaut qu'une colonne
// nulle que rien ne remplit. Elles viendront avec ce qui les utilise.

/// Vocabulaire des revetements, administrable.
model ReferentielRevetement {
  /// Code stable, cite par les portions. Ne change jamais : des portions validees le
  /// portent.
  code        String  @id
  libelle     String
  description String?

  /// ORDRE D'AFFICHAGE, du plus structurant au moins structurant. Sert aux listes, pas
  /// aux calculs.
  ordre Int

  /// `false` retire la valeur des nouveaux choix SANS invalider les portions qui la
  /// portent deja. Supprimer la ligne casserait leur cle etrangere, et une portion dont
  /// on ne sait plus le revetement n'est plus explicable.
  actif Boolean @default(true)

  /// Ce revetement compte-t-il dans la LONGUEUR BITUMEE ?
  ///
  /// Le paragraphe 13 demande « longueur bitumee et non bitumee ». Avec un vocabulaire
  /// administrable, cela ne se deduit pas du code : un libelle que quelqu'un ajoutera
  /// demain ne dira pas au programme s'il est bitumineux. C'est donc une propriete
  /// DECLAREE de la valeur, et celui qui ajoute un revetement doit la trancher.
  ///
  /// Le pave et le beton sont revetus sans etre bitumineux. Une distinction plus fine
  /// (revetu / non revetu) viendra si une statistique la demande ; en inventer une que
  /// rien ne consomme serait du vide.
  bitumineux Boolean

  /// D'ou vient la ligne. Les valeurs d'origine citent le cahier ; celles qu'un
  /// gestionnaire ajoute citent sa decision.
  source String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portions Portion[]

  @@index([actif, ordre])
  @@map("referentiel_revetements")
}

/// Vocabulaire des etats de chaussee, administrable.
model ReferentielEtatChaussee {
  code        String  @id
  libelle     String
  description String?

  /// Du MEILLEUR au PIRE. Contrairement a l'ordre d'un revetement, celui-ci a un sens
  /// metier : il permet de comparer deux etats et de dire lequel est le plus degrade.
  ordre Int

  actif Boolean @default(true)

  /// Cet etat compte-t-il dans la LONGUEUR CRITIQUE du paragraphe 13 ?
  ///
  /// Meme raisonnement que `bitumineux` : avec un vocabulaire administrable, « critique »
  /// n'est pas devinable depuis le code. Declare, donc tranche par celui qui ajoute.
  critique Boolean @default(false)

  source String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portions Portion[]

  @@index([actif, ordre])
  @@map("referentiel_etats_chaussee")
}

/// Vocabulaire des praticabilites, administrable.
///
/// CETTE TABLE SORT VIDE, ET C'EST DELIBERE.
///
/// Le cahier demande un referentiel de praticabilite sans en enoncer AUCUNE valeur, la ou
/// il liste les huit revetements et ou les etats sont deja en usage en production. Ecrire
/// ici « PRATICABLE / DIFFICILE / IMPRATICABLE » en ferait la norme d'AGEROUTE par defaut,
/// alors que personne ne l'a decidee. Meme regle que pour les coefficients du RCI.
///
/// Consequence assumee : aucune portion ne peut porter de praticabilite avant qu'AGEROUTE
/// n'ait rempli cette table. Le mecanisme attend la decision, il ne la devance pas.
model ReferentielPraticabilite {
  code        String @id
  libelle     String
  /// DEFINITION METIER, OBLIGATOIRE — seule des trois tables de referentiel a l'exiger.
  ///
  /// AGEROUTE l'a demandee explicitement pour la praticabilite, et la raison se comprend :
  /// « difficile » ne veut rien dire sans dire pour qui et dans quelles conditions. Un
  /// revetement se reconnait a l'oeil ; une praticabilite se JUGE, et deux agents sans
  /// definition commune jugeront differemment.
  ///
  /// La base l'impose aussi, par contrainte : le type et la contrainte doivent dire la
  /// meme chose, sinon le code croit pouvoir ecrire ce que la base refusera.
  description String

  /// Du plus praticable au moins praticable.
  ordre Int

  actif Boolean @default(true)

  /// La route est-elle franchissable dans cet etat ? Declare, pour les memes raisons que
  /// `bitumineux` et `critique`.
  franchissable Boolean

  /// Une praticabilite peut etre SAISONNIERE : une piste franchissable en saison seche ne
  /// l'est plus en saison des pluies. Vrai quand la valeur ne vaut que pour une periode.
  saisonniere Boolean @default(false)

  /// NULLE = valeur PROPOSEE, pas encore approuvee.
  ///
  /// AGEROUTE a demande le 13/10/2026 de « faire approuver les valeurs avant leur
  /// utilisation officielle ». Officiel, pour une portion, veut dire VALIDE : une valeur
  /// non approuvee peut donc etre portee par une PROPOSITION de terrain, mais empeche sa
  /// validation.
  ///
  /// C'est le seul sens tenable de la consigne. Interdire la saisie aurait rendu le
  /// referentiel inutilisable jusqu'a l'approbation, donc impossible a eprouver sur le
  /// terrain avant de l'approuver — on aurait demande d'approuver a l'aveugle.
  approuveeLe    DateTime?
  approuveeParId String?
  approuveePar   User?     @relation("PraticabiliteApprobateur", fields: [approuveeParId], references: [id])

  source String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portions Portion[]

  @@index([actif, ordre])
  @@map("referentiel_praticabilites")
}
