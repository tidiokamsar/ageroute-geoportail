# Base de donnees
DATABASE_URL="postgresql://bdri_app:changeme@localhost:5432/console_bdri?schema=public"

# Ancienne base sig_routier (PostGIS/PostgREST), utilisee uniquement par scripts/migrate-legacy-data.ts
LEGACY_DATABASE_URL="postgresql://changeme:changeme@changeme:5432/changeme"

# Serveur
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Metadonnees ISO 19115 (facultatif : sans valeur, les fiches signalent la lacune)
# METADATA_CONTACT_EMAIL=metadonnees@example.org
# PUBLIC_BASE_URL=https://carte.example.org

# JWT
JWT_ACCESS_SECRET="changeme-access-secret-min-32-chars"
JWT_REFRESH_SECRET="changeme-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Limitation de debit (par adresse, compteur en memoire du processus). 0 desactive le plafond.
# /api/auth/refresh : 60 par 15 minutes. /api/v2 : 1200 par minute (valeur LARGE : une file de synchronisation part en rafale).
# RATE_LIMIT_REFRESH_MAX=60
# RATE_LIMIT_REFRESH_FENETRE_MIN=15
# RATE_LIMIT_V2_MAX=1200
# RATE_LIMIT_V2_FENETRE_SEC=60

# Integrations sortantes (outbox, docs/integrations/SORTANTS.md). TOUT EST DESACTIVE PAR DEFAUT.
# Aucune de ces variables n'a de valeur par defaut : le depot ne connait ni l'adresse, ni le chemin, ni
# l'authentification de DigitalRoad, de SharePoint ou de la BDR / L2R (B-11, B-12). Une destination
# n'est active que si l'interrupteur general, son ACTIF, son URL (https), son CHEMIN et son JETON sont
# tous renseignes. Les valeurs reelles ne vont JAMAIS dans ce fichier ni dans le depot.
# INTEGRATIONS_SORTANTES_ACTIVES=true
# OUTBOX_DIGITALROAD_ACTIF=true
# OUTBOX_DIGITALROAD_URL=
# OUTBOX_DIGITALROAD_CHEMIN=
# OUTBOX_DIGITALROAD_JETON=
# OUTBOX_DIGITALROAD_TIMEOUT_MS=10000
# (idem pour OUTBOX_SHAREPOINT_* et OUTBOX_BDR_L2R_*)
# Reprise : OUTBOX_TENTATIVES_MAX=8, OUTBOX_DELAI_BASE_MS=30000, OUTBOX_DELAI_PLAFOND_MS=3600000,
# OUTBOX_VERROU_MS=120000, OUTBOX_LOT_MAX=20

# Compte administrateur initial (utilise par le seed)
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD="changeme-mot-de-passe-admin-initial"
SEED_ADMIN_NAME="Administrateur"
