{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@playwright/test": ["../frontend/node_modules/@playwright/test"],
      "pg": ["../backend/node_modules/pg/lib/index.js"],
      "argon2": ["../backend/node_modules/argon2"]
    }
  },
  "include": ["**/*.ts"]
}
